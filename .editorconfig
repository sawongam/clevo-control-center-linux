root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{axaml,xaml,csproj,props,slnx,json,yml,yaml}]
indent_size = 2

[{Makefile,*.mk}]
indent_style = tab

[*.{c,h}]
indent_style = tab
indent_size = 8
