<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FanSpeedSetting" xmlns:UControl="clr-namespace:FanSpeedSetting.UControl" x:Class="FanSpeedSetting.Page_system_monitor" Name="userControl" Width="1920" Height="1080" BorderBrush="#FFFF0000">
  <UserControl.Resources>
    <SolidColorBrush x:Key="Button.Static.Background" Color="#FFDDDDDD" />
    <SolidColorBrush x:Key="Button.Static.Border" Color="#FF707070" />
    <SolidColorBrush x:Key="Button.Disabled.Background" Color="#FFF4F4F4" />
    <SolidColorBrush x:Key="Button.Disabled.Border" Color="#FFADB2B5" />
    <SolidColorBrush x:Key="Button.Disabled.Foreground" Color="#FF838383" />
    <SolidColorBrush x:Key="RadioButton.Static.Background" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="RadioButton.Static.Border" Color="#FF707070" />
    <SolidColorBrush x:Key="OptionMark.Static.Background" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="OptionMark.Static.Border" Color="#FF707070" />
    <ControlTheme x:Key="RBTN_GPU_selected" TargetType="RadioButton">
      <Setter Property="Background" Value="{StaticResource RadioButton.Static.Background}" />
      <Setter Property="BorderBrush" Value="{StaticResource RadioButton.Static.Border}" />
      <Setter Property="Foreground" Value="#FF000000" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Name="templateRoot" Background="#00FFFFFF">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Rectangle Name="rectangle" Fill="{TemplateBinding Foreground}" StrokeThickness="0" Width="50" Stroke="{x:Null}" />
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^ /template/ Rectangle#rectangle">
        <Setter Property="OpacityMask">
          <ImageBrush Source="/image/page_systemmonitor/btn_gpu1_normal.png" />
        </Setter>
      </Style>
      <Style Selector="^:pointerover">
        <Setter Property="OpacityMask">
          <ImageBrush Source="/image/page_systemmonitor/btn_gpu1_hover.png" />
        </Setter>
      </Style>
      <Style Selector="^:checked /template/ Rectangle#rectangle">
        <Setter Property="OpacityMask">
          <ImageBrush Source="/image/page_systemmonitor/btn_gpu1_selected.png" />
        </Setter>
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="RBTN_GPUSelected2" TargetType="RadioButton">
      <Setter Property="Background" Value="{StaticResource RadioButton.Static.Background}" />
      <Setter Property="BorderBrush" Value="{StaticResource RadioButton.Static.Border}" />
      <Setter Property="Foreground" Value="#FF000000" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Name="templateRoot" Background="#00FFFFFF">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Rectangle Name="rectangle" Grid.ColumnSpan="2" Fill="{TemplateBinding Foreground}" Margin="0" StrokeThickness="0" Width="50" Height="50" Stroke="{x:Null}" />
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^ /template/ Rectangle#rectangle">
        <Setter Property="OpacityMask">
          <ImageBrush Source="/image/page_systemmonitor/btn_gpu2_normal.png" />
        </Setter>
      </Style>
      <Style Selector="^:pointerover /template/ Rectangle#rectangle">
        <Setter Property="OpacityMask">
          <ImageBrush Source="/image/page_systemmonitor/btn_gpu2_hover.png" />
        </Setter>
      </Style>
      <Style Selector="^:checked /template/ Rectangle#rectangle">
        <Setter Property="OpacityMask">
          <ImageBrush Source="/image/page_systemmonitor/btn_gpu2_selected.png" />
        </Setter>
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="ButtonStyle1_reset1" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Button.Static.Background}" />
      <Setter Property="BorderBrush" Value="{StaticResource Button.Static.Border}" />
      <Setter Property="Foreground" Value="#FF000000" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="1" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="border">
            <WrapPanel Margin="0">
              <Image Name="Image_Page_SystemMonitor_btn_save_normal_png" Margin="0" Stretch="Fill" Width="56" Height="56" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="Hand" />
              <TextBlock Name="textBlock" TextWrapping="Wrap" Text="{TemplateBinding Content}" VerticalAlignment="Center" />
            </WrapPanel>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^ /template/ Image#Image_Page_SystemMonitor_btn_save_normal_png">
        <Setter Property="Source" Value="/image/page_systemmonitor/btn_default_normal.png" />
      </Style>
      <Style Selector="^:pointerover /template/ Image#Image_Page_SystemMonitor_btn_save_normal_png">
        <Setter Property="Source" Value="/image/page_systemmonitor/btn_default_hover.png" />
      </Style>
      <Style Selector="^:pressed /template/ Image#Image_Page_SystemMonitor_btn_save_normal_png">
        <Setter Property="Source" Value="/image/page_systemmonitor/btn_save_pressed.png" />
      </Style>
      <Style Selector="^:pressed /template/ TextBlock#textBlock">
        <Setter Property="Foreground" Value="#FF808080" />
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="ButtonStyle1_SAVE" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Button.Static.Background}" />
      <Setter Property="BorderBrush" Value="{StaticResource Button.Static.Border}" />
      <Setter Property="Foreground" Value="#FF000000" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="1" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="border">
            <WrapPanel Margin="0">
              <Image Name="Image_Page_SystemMonitor_btn_save_normal_png" Margin="0" Stretch="Fill" Width="56" Height="56" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="Hand" />
              <TextBlock Name="textBlock" TextWrapping="Wrap" Text="{TemplateBinding Content}" VerticalAlignment="Center" />
            </WrapPanel>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^ /template/ Image#Image_Page_SystemMonitor_btn_save_normal_png">
        <Setter Property="Source" Value="/image/page_systemmonitor/btn_save_normal.png" />
      </Style>
      <Style Selector="^:pointerover /template/ Image#Image_Page_SystemMonitor_btn_save_normal_png">
        <Setter Property="Source" Value="/image/page_systemmonitor/btn_save_hover.png" />
      </Style>
      <Style Selector="^:pressed /template/ Image#Image_Page_SystemMonitor_btn_save_normal_png">
        <Setter Property="Source" Value="/image/page_systemmonitor/btn_save_pressed.png" />
      </Style>
      <Style Selector="^:pressed /template/ TextBlock#textBlock">
        <Setter Property="Foreground" Value="#FF808080" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Opacity" Value="0.2" />
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="RadioButtonStyle1_FAN" TargetType="RadioButton">
      <Setter Property="Background" Value="{StaticResource RadioButton.Static.Background}" />
      <Setter Property="BorderBrush" Value="{StaticResource RadioButton.Static.Border}" />
      <Setter Property="Foreground" Value="#FF000000" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Name="templateRoot" Background="#00FFFFFF">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Height="46" Margin="0" VerticalAlignment="Center" Width="46">
              <Rectangle Name="rectangle1" Margin="0" Width="46" Height="46" StrokeThickness="0" Fill="#FF444444" Stroke="{x:Null}">
                <Rectangle.OpacityMask>
                  <ImageBrush Source="/image/page_systemmonitor/fan/btn_enable.png" />
                </Rectangle.OpacityMask>
              </Rectangle>
            </Grid>
            <Grid Name="grid" Height="46" Margin="0" VerticalAlignment="Center" Width="46">
              <Rectangle Name="rectangle" Margin="0" Width="46" Height="46" StrokeThickness="0" Fill="{TemplateBinding Background}" Stroke="{x:Null}" />
            </Grid>
            <Border Name="radioButtonBorder" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="100" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="1,1,2,1" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" IsVisible="False" />
            <TextBlock Name="textBlock" Grid.Column="1" Margin="0" TextWrapping="Wrap" Text="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalAlignment="Left" />
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^ /template/ Rectangle#rectangle">
        <Setter Property="OpacityMask">
          <ImageBrush Source="/image/page_systemmonitor/fan/btn_enable.png" />
        </Setter>
      </Style>
      <Style Selector="^ /template/ TextBlock#textBlock">
        <Setter Property="FontSize" Value="21.333" />
      </Style>
      <Style Selector="^ /template/ TextBlock#textBlock">
        <Setter Property="Foreground" Value="#FFB4B4B4" />
      </Style>
      <Style Selector="^:disabled /template/ TextBlock#textBlock">
        <Setter Property="Foreground" Value="#FF353535" />
      </Style>
      <Style Selector="^:disabled /template/ Grid#grid">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="^:checked /template/ Rectangle#rectangle">
        <Setter Property="OpacityMask">
          <ImageBrush Source="/image/page_systemmonitor/fan/btn_disable.png" />
        </Setter>
      </Style>
      <Style Selector="^:checked /template/ TextBlock#textBlock">
        <Setter Property="Foreground" Value="#FFFFFFFF" />
      </Style>
      <Style Selector="^:checked /template/ TextBlock#textBlock">
        <Setter Property="FontSize" Value="24" />
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="RadioButtonStyle1_customFan" TargetType="RadioButton">
      <Setter Property="Background" Value="{StaticResource RadioButton.Static.Background}" />
      <Setter Property="BorderBrush" Value="{StaticResource RadioButton.Static.Border}" />
      <Setter Property="Foreground" Value="#FF000000" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Name="templateRoot" Background="#00FFFFFF">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Height="46" Margin="0,0,5,0" VerticalAlignment="Center" Width="46">
              <Rectangle Name="rectangle" Margin="0" Width="46" Height="46" StrokeThickness="0" Stroke="{x:Null}" OpacityMask="{x:Null}" />
            </Grid>
            <Border Name="radioButtonBorder" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="100" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="1,22,0,12.4" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" IsVisible="False" />
            <TextBlock Name="textBlock" Grid.Column="1" Margin="5,0,0,0" TextWrapping="Wrap" Text="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="{TemplateBinding Foreground}" FontSize="21.333" IsVisible="True" />
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^ /template/ Rectangle#rectangle">
        <Setter Property="Fill">
          <ImageBrush Source="/image/page_systemmonitor/fansetting/btn_fan_cpu_normal.png" />
        </Setter>
      </Style>
      <Style Selector="^ /template/ TextBlock#textBlock">
        <Setter Property="OpacityMask" Value="#7F000000" />
      </Style>
      <Style Selector="^:pointerover /template/ Rectangle#rectangle">
        <Setter Property="Fill">
          <ImageBrush Source="/image/page_systemmonitor/fansetting/btn_fan_cpu_hover.png" />
        </Setter>
      </Style>
      <Style Selector="^:checked /template/ Rectangle#rectangle">
        <Setter Property="Fill">
          <ImageBrush Source="/image/page_systemmonitor/fansetting/btn_fan_cpu_selected.png" />
        </Setter>
      </Style>
      <Style Selector="^:checked /template/ TextBlock#textBlock">
        <Setter Property="OpacityMask" Value="#FF000000" />
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="RadioButtonStyle_customFanGPU" TargetType="RadioButton">
      <Setter Property="Background" Value="{StaticResource RadioButton.Static.Background}" />
      <Setter Property="BorderBrush" Value="{StaticResource RadioButton.Static.Border}" />
      <Setter Property="Foreground" Value="#FF000000" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Name="templateRoot" Background="#00FFFFFF">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Height="46" Margin="0,0,5,0" VerticalAlignment="Center" Width="46">
              <Rectangle Name="rectangle" Margin="0" Width="46" Height="46" StrokeThickness="0" Stroke="{x:Null}" OpacityMask="{x:Null}" />
            </Grid>
            <Border Name="radioButtonBorder_Copy" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="100" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="1,26.8,0,-3.6" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" IsVisible="False" />
            <TextBlock Name="textBlock" Grid.Column="1" Margin="5,0,0,0" TextWrapping="Wrap" Text="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="{TemplateBinding Foreground}" FontSize="21.333" IsVisible="True" />
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^ /template/ Rectangle#rectangle">
        <Setter Property="Fill">
          <ImageBrush Source="/image/page_systemmonitor/fansetting/btn_fan_gpu1_normal.png" />
        </Setter>
      </Style>
      <Style Selector="^ /template/ TextBlock#textBlock">
        <Setter Property="OpacityMask" Value="#7F000000" />
      </Style>
      <Style Selector="^:pointerover /template/ Rectangle#rectangle">
        <Setter Property="Fill">
          <ImageBrush Source="/image/page_systemmonitor/fansetting/btn_fan_gpu1_hover.png" />
        </Setter>
      </Style>
      <Style Selector="^:checked /template/ Rectangle#rectangle">
        <Setter Property="Fill">
          <ImageBrush Source="/image/page_systemmonitor/fansetting/btn_gpu1_selected.png" />
        </Setter>
      </Style>
      <Style Selector="^:checked /template/ TextBlock#textBlock">
        <Setter Property="OpacityMask" Value="#FF000000" />
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="RadioButtonStyle1_custonFanGPU2" TargetType="RadioButton">
      <Setter Property="Background" Value="{StaticResource RadioButton.Static.Background}" />
      <Setter Property="BorderBrush" Value="{StaticResource RadioButton.Static.Border}" />
      <Setter Property="Foreground" Value="#FF000000" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Name="templateRoot" Background="#00FFFFFF">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Height="46" Margin="0,0,5,0" VerticalAlignment="Center" Width="46">
              <Rectangle Name="rectangle" Margin="0" Width="46" Height="46" StrokeThickness="0" Stroke="{x:Null}" OpacityMask="{x:Null}" />
            </Grid>
            <Border Name="radioButtonBorder_Copy" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="100" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="1,26.8,0,-3.6" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" IsVisible="False" />
            <TextBlock Name="textBlock" Grid.Column="1" Margin="5,0,0,0" TextWrapping="Wrap" Text="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="{TemplateBinding Foreground}" FontSize="21.333" IsVisible="True" />
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^ /template/ Rectangle#rectangle">
        <Setter Property="Fill">
          <ImageBrush Source="/image/page_systemmonitor/fansetting/btn_fan_gpu2_normal.png" />
        </Setter>
      </Style>
      <Style Selector="^ /template/ TextBlock#textBlock">
        <Setter Property="OpacityMask" Value="#7F000000" />
      </Style>
      <Style Selector="^:pointerover /template/ Rectangle#rectangle">
        <Setter Property="Fill">
          <ImageBrush Source="/image/page_systemmonitor/fansetting/btn_fan_gpu2_hover.png" />
        </Setter>
      </Style>
