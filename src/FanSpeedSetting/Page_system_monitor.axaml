    <ControlTheme x:Key="CheckBoxStyle1" TargetType="CheckBox">
      <Setter Property="Background" Value="{StaticResource OptionMark.Static.Background}" />
      <Setter Property="BorderBrush" Value="{StaticResource OptionMark.Static.Border}" />
      <Setter Property="Foreground" Value="#FF000000" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Name="templateRoot" Background="#00FFFFFF" Margin="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Rectangle Name="rectangle" Grid.ColumnSpan="2" Margin="0" StrokeThickness="0" RenderTransformOrigin="50%,50%" Fill="#FF242424" Stroke="{x:Null}">
              <Rectangle.RenderTransform>
                <TransformGroup>
                  <ScaleTransform />
                  <SkewTransform AngleX="-30" />
                  <RotateTransform />
                  <TranslateTransform />
                </TransformGroup>
              </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle Name="rectangle_Copy" Grid.ColumnSpan="2" Margin="0" StrokeThickness="0" RenderTransformOrigin="50%,50%" Fill="{TemplateBinding Background}" IsVisible="False" Stroke="{x:Null}">
              <Rectangle.RenderTransform>
                <TransformGroup>
                  <ScaleTransform />
                  <SkewTransform AngleX="-30" />
                  <RotateTransform />
                  <TranslateTransform />
                </TransformGroup>
              </Rectangle.RenderTransform>
            </Rectangle>
            <Border Name="radioButtonBorder" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="100" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="1,1,2,1" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" IsVisible="False" />
            <TextBlock Name="textBlock" Grid.Column="1" Margin="20,0" TextWrapping="Wrap" Text="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="21.333" />
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^ /template/ TextBlock#textBlock">
        <Setter Property="Foreground" Value="#FFB4B4B4" />
      </Style>
      <Style Selector="^:disabled /template/ Grid#templateRoot">
        <Setter Property="Opacity" Value="0.1" />
      </Style>
      <Style Selector="^:checked /template/ TextBlock#textBlock">
        <Setter Property="Foreground" Value="#FFFFFFFF" />
      </Style>
      <Style Selector="^:checked /template/ Rectangle#rectangle_Copy">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <Style Selector="^:not(:checked) /template/ Rectangle#rectangle_Copy">
        <Setter Property="IsVisible" Value="False" />
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="CheckBoxStyle2" TargetType="CheckBox">
      <Setter Property="Background" Value="{StaticResource OptionMark.Static.Background}" />
      <Setter Property="BorderBrush" Value="{StaticResource OptionMark.Static.Border}" />
      <Setter Property="Foreground" Value="#FF000000" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Name="templateRoot" Background="#00FFFFFF">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Height="46" Margin="0" VerticalAlignment="Center" Width="46">
              <Rectangle Name="rectangle" Margin="0" Width="46" Height="46" StrokeThickness="0" Fill="{TemplateBinding Background}" Stroke="{x:Null}" />
            </Grid>
            <TextBlock Name="textBlock" Grid.Column="1" Margin="0" TextWrapping="Wrap" Text="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="24" FontFamily="Microsoft Sans Serif" />
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^ /template/ Rectangle#rectangle">
        <Setter Property="OpacityMask">
          <ImageBrush Source="/image/page_systemmonitor/fan/btn_enable.png" />
        </Setter>
      </Style>
      <Style Selector="^ /template/ TextBlock#textBlock">
        <Setter Property="Foreground" Value="#FFB4B4B4" />
      </Style>
      <Style Selector="^:checked /template/ TextBlock#textBlock">
        <Setter Property="Foreground" Value="#FFFFFFFF" />
      </Style>
      <Style Selector="^:checked /template/ Rectangle#rectangle">
        <Setter Property="OpacityMask">
          <ImageBrush Source="/image/page_systemmonitor/fan/btn_disable.png" />
        </Setter>
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="ButtonStyle_Setting" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Button.Static.Background}" />
      <Setter Property="BorderBrush" Value="{StaticResource Button.Static.Border}" />
      <Setter Property="Foreground" Value="#FF000000" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="1" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid HorizontalAlignment="Stretch" Margin="0" VerticalAlignment="Stretch">
            <Rectangle Margin="0" VerticalAlignment="Stretch" Fill="{TemplateBinding Background}" StrokeThickness="0" Stroke="{x:Null}">
              <Rectangle.OpacityMask>
                <LinearGradientBrush EndPoint="96.9%,50.6%" StartPoint="0.6%,48.5%">
                  <GradientStop Color="#7F000000" Offset="0.759" />
                  <GradientStop />
                  <GradientStop Color="#B2333333" Offset="0.428" />
                  <GradientStop Color="#00000000" Offset="1" />
                </LinearGradientBrush>
              </Rectangle.OpacityMask>
            </Rectangle>
            <WrapPanel Name="wrapPanel" HorizontalAlignment="Left" Margin="37,0,0,-0.4" VerticalAlignment="Center" Width="357">
              <TextBlock TextWrapping="Wrap" Text="{TemplateBinding Content}" Width="310" TextAlignment="Center" />
            </WrapPanel>
            <Path Data="M10,67.5 L305,67" HorizontalAlignment="Right" Height="3" Margin="0" Stretch="Fill" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="3" UseLayoutRounding="False" VerticalAlignment="Bottom" Fill="{x:Null}">
              <Path.OpacityMask>
                <LinearGradientBrush EndPoint="99.2%,11.4%" StartPoint="-0.4%,34.1%">
                  <GradientStop Color="#00000000" Offset="0" />
                  <GradientStop Color="White" Offset="0.504" />
                  <GradientStop Offset="1" />
                </LinearGradientBrush>
              </Path.OpacityMask>
            </Path>
          </Grid>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="ButtonStyle1_antiDust" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Button.Static.Background}" />
      <Setter Property="BorderBrush" Value="{StaticResource Button.Static.Border}" />
      <Setter Property="Foreground" Value="#FF000000" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="1" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="border" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
            <TextBlock Name="textBlock" HorizontalAlignment="Stretch" Margin="0" TextWrapping="Wrap" Text="{TemplateBinding Content}" VerticalAlignment="Center" TextAlignment="Center" Width="700" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^ /template/ Border#border">
        <Setter Property="Background">
          <LinearGradientBrush EndPoint="0.1%,49.8%" StartPoint="99.3%,47.8%">
            <GradientStop Color="#00000000" Offset="0" />
            <GradientStop Color="#00000000" Offset="0.984" />
            <GradientStop Color="#FF3F3E3E" Offset="0.475" />
          </LinearGradientBrush>
        </Setter>
      </Style>
      <Style Selector="^:disabled /template/ TextBlock#textBlock">
        <Setter Property="Foreground" Value="#FF919191" />
      </Style>
      <Style Selector="^:pressed /template/ Border#border">
        <Setter Property="Background">
          <LinearGradientBrush EndPoint="-1%,49.8%" StartPoint="99.3%,48.8%">
            <GradientStop Color="#001F1F1F" Offset="0" />
            <GradientStop Color="#006F6F6F" Offset="0.984" />
            <GradientStop Color="#CC060606" Offset="0.495" />
          </LinearGradientBrush>
        </Setter>
      </Style>
      <Style Selector="^:disabled /template/ Border#border">
        <Setter Property="Background" Value="{x:Null}" />
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="TextBlockStyle2_TIME" TargetType="TextBlock">
      <Style Selector="^:disabled">
        <Setter Property="Foreground" Value="#FF5C5C5C" />
      </Style>
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="TextTrimming" Value="None" />
      <Setter Property="Foreground" Value="#FFFFFFFF" />
    </ControlTheme>
    <SolidColorBrush x:Key="Button.MouseOver.Background" Color="#FFBEE6FD" />
    <SolidColorBrush x:Key="Button.MouseOver.Border" Color="#FF3C7FB1" />
    <SolidColorBrush x:Key="Button.Pressed.Background" Color="#FFC4E5F6" />
    <SolidColorBrush x:Key="Button.Pressed.Border" Color="#FF2C628B" />
    <ControlTheme x:Key="ComboBoxStyle_dropdown" TargetType="ComboBox">
      <Setter Property="Foreground" Value="#FF000000" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="6,3,5,3" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Name="templateRoot">
            <Border Name="templateBg" Background="{TemplateBinding Background}" RenderTransformOrigin="50%,50%" Cursor="Hand">
              <Border.RenderTransform>
                <SkewTransform AngleX="-32" />
              </Border.RenderTransform>
            </Border>
            <ContentControl Name="contentPresenter" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding ItemTemplate}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" IsHitTestVisible="False" />
            <Path Name="arrow" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" Data="M0,0 L2.667,2.66665 L5.3334,0 L5.3334,-1.78168 L2.6667,0.88501 L0,-1.78168 L0,0" Fill="#FF606060" IsHitTestVisible="False" />
            <Popup Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}" MinWidth="126" PlacementTarget="{Binding #templateRoot}" IsLightDismissEnabled="True">
              <Border Background="#FF272727" MaxHeight="150" MinWidth="126">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter Name="PART_ItemsPresenter" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </UserControl.Resources>
