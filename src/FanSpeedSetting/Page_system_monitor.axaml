              <SkewTransform AngleY="0" AngleX="0" />
              <RotateTransform Angle="0" />
              <TranslateTransform />
            </TransformGroup>
          </Rectangle.RenderTransform>
          <Rectangle.Fill>
            <ImageBrush Source="/image/page_systemmonitor/fan/rim_in.png" />
          </Rectangle.Fill>
        </Rectangle>
        <Ellipse HorizontalAlignment="Left" Height="45" Margin="139.8,134,0,0" StrokeThickness="2" VerticalAlignment="Top" Width="45" Stroke="#FFFDFDFD">
          <Ellipse.Fill>
            <RadialGradientBrush>
              <GradientStop Color="#FF303030" Offset="1" />
              <GradientStop Color="#FF545454" />
            </RadialGradientBrush>
          </Ellipse.Fill>
        </Ellipse>
        <Rectangle Name="UI_TurboFan_CPU1" Fill="#FFFFFF00" HorizontalAlignment="Left" Height="44.7" Margin="141.957,137.127,0,0" StrokeThickness="1" Stroke="#FF000000" VerticalAlignment="Top" Width="43.2" RenderTransformOrigin="50%,50%">
          <Rectangle.RenderTransform>
            <TransformGroup>
              <ScaleTransform ScaleY="1" ScaleX="1" />
              <SkewTransform AngleY="0" AngleX="0" />
              <RotateTransform Angle="0" />
              <TranslateTransform />
            </TransformGroup>
          </Rectangle.RenderTransform>
          <Rectangle.OpacityMask>
            <ImageBrush Source="/image/page_systemmonitor/fan/btn_memory_xmp2_hover.png" />
          </Rectangle.OpacityMask>
        </Rectangle>
      </Grid>
    </Viewbox>
    <StackPanel Name="SP_FANBTN" Height="302" Margin="0,190,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" Width="160">
      <StackPanel Name="SP_Auto" Height="46" Margin="0,0,0,10">
        <RadioButton Name="RB_FAN_auto" Content="Automatic" Margin="0" Foreground="#FFFFFFFF" FontFamily="Microsoft Sans Serif" FontSize="24" Theme="{StaticResource RadioButtonStyle1_FAN}" VerticalContentAlignment="Center" Cursor="Hand" Height="46" Focusable="False" IsChecked="True" GroupName="FanMode" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{Binding #userControl.BorderBrush}" />
      </StackPanel>
      <StackPanel Name="SP_Max" Height="46" Margin="0,0,0,10">
        <RadioButton Name="RB_FAN_max" Content="Maximum" Margin="0" Foreground="#FFFFFFFF" FontFamily="Microsoft Sans Serif" FontSize="24" Theme="{StaticResource RadioButtonStyle1_FAN}" VerticalContentAlignment="Center" Cursor="Hand" Height="46" VerticalAlignment="Top" Focusable="False" GroupName="FanMode" HorizontalAlignment="Left" Background="{Binding #RB_FAN_auto.Background}" />
      </StackPanel>
      <StackPanel Name="SP_MaxQ" Height="46" Margin="0,0,0,10">
        <RadioButton Name="RB_FAN_Maxq" Content="MAX-Q" Foreground="#FFFFFFFF" FontFamily="Microsoft Sans Serif" FontSize="24" Theme="{StaticResource RadioButtonStyle1_FAN}" VerticalContentAlignment="Center" Cursor="Hand" Height="45.9" VerticalAlignment="Top" Focusable="False" GroupName="FanMode" HorizontalAlignment="Left" Background="{Binding #RB_FAN_auto.Background}" />
      </StackPanel>
      <StackPanel Name="SP_Silent" Height="46" Margin="0,0,0,10">
        <RadioButton Name="RB_FAN_Silent" Content="Silent" HorizontalAlignment="Left" Margin="0" Foreground="#FFFFFFFF" FontFamily="Microsoft Sans Serif" FontSize="24" Theme="{StaticResource RadioButtonStyle1_FAN}" VerticalContentAlignment="Center" Cursor="Hand" Height="46" VerticalAlignment="Top" Focusable="False" GroupName="FanMode" Background="{Binding #RB_FAN_auto.Background}" />
      </StackPanel>
      <StackPanel Name="SP_Custom" Height="46" Margin="0,0,0,10">
        <RadioButton Name="RB_FAN_custom" Content="Custom" Margin="0" Foreground="#FFFFFFFF" FontFamily="Microsoft Sans Serif" FontSize="24" Theme="{StaticResource RadioButtonStyle1_FAN}" VerticalContentAlignment="Center" Cursor="Hand" Height="46" Focusable="False" GroupName="FanMode" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{Binding #RB_FAN_auto.Background}" />
      </StackPanel>
    </StackPanel>
    <UControl:UserControl_DialogBox Name="UC_DialogBox" Margin="0" IsVisible="False" />
  </Grid>
</UserControl>

