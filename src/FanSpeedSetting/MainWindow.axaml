<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FanSpeedSetting" xmlns:UControl="clr-namespace:FanSpeedSetting.UControl" x:Class="FanSpeedSetting.MainWindow" Name="window" FontSize="12" Title="Fan Speed Setting" Height="1080" Width="1920" Background="#FF242424" BorderThickness="0,0,1,1" WindowDecorations="None" Topmost="True" CanResize="True" BorderBrush="{Binding #Check_FullSrceen.Background}">
  <Window.Resources>
    <SolidColorBrush x:Key="OptionMark.Static.Background" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="OptionMark.Static.Border" Color="#FF707070" />
    <ControlTheme x:Key="BTN_MIN" TargetType="Button">
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Name="grid" Margin="0" Background="{x:Null}">
            <Image Name="Image_ic_close_png" Margin="0" Source="/image/main/ic_minimize.png" Stretch="Fill" Height="60" />
            <Rectangle Name="rectangle" Margin="0" Height="60" Fill="{TemplateBinding Background}" StrokeThickness="0" Stroke="{x:Null}" />
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^ /template/ Rectangle#rectangle">
        <Setter Property="OpacityMask">
          <LinearGradientBrush EndPoint="50%,100%" StartPoint="50%,0%">
            <GradientStop Color="#00000000" />
            <GradientStop Color="#33FFFFFF" Offset="1" />
          </LinearGradientBrush>
        </Setter>
      </Style>
      <Style Selector="^:pressed /template/ Rectangle#rectangle">
        <Setter Property="OpacityMask">
          <LinearGradientBrush EndPoint="50%,100%" StartPoint="50%,0%">
            <GradientStop Color="#00000000" Offset="1" />
            <GradientStop Color="#66FFFFFF" Offset="0" />
          </LinearGradientBrush>
        </Setter>
      </Style>
      <Style Selector="^:pointerover /template/ Rectangle#rectangle">
        <Setter Property="OpacityMask">
          <LinearGradientBrush EndPoint="50%,100%" StartPoint="50%,0%">
            <GradientStop Color="#00000000" />
            <GradientStop Color="#66FFFFFF" Offset="1" />
          </LinearGradientBrush>
        </Setter>
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="S_BTN_CLOSE" TargetType="Button">
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Name="grid" Margin="0" Background="{x:Null}">
            <Image Name="Image_ic_close_png" Margin="0" Source="/image/main/ic_close.png" Stretch="Fill" Height="60" />
            <Rectangle Name="rectangle" Margin="0" Height="60" Fill="{TemplateBinding Background}" StrokeThickness="0" Stroke="{x:Null}" />
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^ /template/ Rectangle#rectangle">
        <Setter Property="OpacityMask">
          <LinearGradientBrush EndPoint="50%,100%" StartPoint="50%,0%">
            <GradientStop Color="#00000000" />
            <GradientStop Color="#33FFFFFF" Offset="1" />
          </LinearGradientBrush>
        </Setter>
      </Style>
      <Style Selector="^:pressed /template/ Rectangle#rectangle">
        <Setter Property="OpacityMask">
          <LinearGradientBrush EndPoint="50%,100%" StartPoint="50%,0%">
            <GradientStop Color="#00000000" Offset="1" />
            <GradientStop Color="#66FFFFFF" Offset="0" />
          </LinearGradientBrush>
        </Setter>
      </Style>
      <Style Selector="^:pointerover /template/ Rectangle#rectangle">
        <Setter Property="OpacityMask">
          <LinearGradientBrush EndPoint="50%,100%" StartPoint="50%,0%">
            <GradientStop Color="#00000000" />
            <GradientStop Color="#66FFFFFF" Offset="1" />
          </LinearGradientBrush>
        </Setter>
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="CheckBox_FullScreen" TargetType="CheckBox">
      <Setter Property="Background" Value="{StaticResource OptionMark.Static.Background}" />
      <Setter Property="BorderBrush" Value="{StaticResource OptionMark.Static.Border}" />
      <Setter Property="Foreground" Value="#FF000000" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Name="templateRoot" Background="#00FFFFFF">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Name="Image_ic_close_png" Margin="0" Stretch="Fill" Width="80" Height="60" />
            <Rectangle Name="rectangle" Margin="0" Width="80" Height="60" Fill="{TemplateBinding Background}" StrokeThickness="0" Stroke="{x:Null}" />
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^ /template/ Image#Image_ic_close_png">
        <Setter Property="Source" Value="/image/main/ic_fullscreen.png" />
      </Style>
      <Style Selector="^ /template/ Rectangle#rectangle">
        <Setter Property="OpacityMask">
          <LinearGradientBrush EndPoint="50%,100%" StartPoint="50%,0%">
            <GradientStop Color="#00000000" Offset="0" />
            <GradientStop Color="#33FFFFFF" Offset="1" />
          </LinearGradientBrush>
        </Setter>
      </Style>
      <Style Selector="^:pointerover /template/ Rectangle#rectangle">
        <Setter Property="OpacityMask">
          <LinearGradientBrush EndPoint="50%,100%" StartPoint="50%,0%">
            <GradientStop Color="#00000000" Offset="0" />
            <GradientStop Color="#66FFFFFF" Offset="1" />
          </LinearGradientBrush>
        </Setter>
      </Style>
      <Style Selector="^:pressed /template/ Rectangle#rectangle">
        <Setter Property="OpacityMask">
          <LinearGradientBrush EndPoint="50%,100%" StartPoint="50%,0%">
            <GradientStop Color="#66000000" Offset="0" />
            <GradientStop Color="Transparent" Offset="1" />
          </LinearGradientBrush>
        </Setter>
      </Style>
      <Style Selector="^:checked /template/ Image#Image_ic_close_png">
        <Setter Property="Source" Value="/image/main/ic_window.png" />
      </Style>
    </ControlTheme>
  </Window.Resources>
  <Grid Margin="0">
    <Rectangle Name="r1" Margin="0" Width="1920" Height="1080" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{Binding #title_icon.Fill}">
      <Rectangle.OpacityMask>
        <ImageBrush Source="/image/main/bg_cpu_layer2.png" />
      </Rectangle.OpacityMask>
    </Rectangle>
    <Rectangle Name="r2" Margin="0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="1920" Height="1080">
      <Rectangle.Fill>
        <ImageBrush Source="/image/fanspeedsetting/bg_fan_less_layer3.png" />
      </Rectangle.Fill>
    </Rectangle>
    <Rectangle Name="r3" Margin="0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="1920" Height="1080">
      <Rectangle.Fill>
        <ImageBrush Source="/image/fanspeedsetting/bg_fan_more_layer3.png" />
      </Rectangle.Fill>
    </Rectangle>
    <Viewbox Name="VB_main" Margin="0" Width="1920" Height="1080">
      <Grid Name="_base" Height="1080" Width="1920">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <StackPanel Name="SP_page_system_monitor" Margin="0">
          <local:Page_system_monitor Name="page_system_monitor" Height="1080" Margin="0" Width="1920" IsVisible="True" BorderBrush="{Binding #title_icon.Fill}" />
        </StackPanel>
        <UControl:UserControl_DialogBox Name="UC_DialogBox" Margin="0" IsVisible="False" />
      </Grid>
    </Viewbox>
    <Viewbox Name="VB_title" HorizontalAlignment="Center" Height="81" Margin="0" VerticalAlignment="Top" Width="1920">
      <Grid Name="main_title_icon" HorizontalAlignment="Left" Height="81" Margin="0" VerticalAlignment="Top" Width="1920">
        <Path Name="title_move2" PointerPressed="title_move_PointerPressed" PointerMoved="title_move_PointerMoved" Data="M510.66635,-0.26633186 L1409.9492,-0.31084213 L1414.1252,81.143416 C1414.1252,81.143416 512.34961,81.187468 512.34961,81.187468" Fill="#02242424" Stretch="Fill" StrokeThickness="0" Cursor="SizeAll" HorizontalAlignment="Left" Width="1920" Margin="0,0,0,0.2" Stroke="{x:Null}" />
        <Rectangle Name="title_icon" Margin="503.667,2.254,506.333,-0.254" StrokeThickness="0" Height="79" Fill="#FFFF00D2" Stroke="{Binding #title_icon.Fill}">
          <Rectangle.OpacityMask>
            <ImageBrush Source="/image/main/bg_title_bar_3.png" />
          </Rectangle.OpacityMask>
        </Rectangle>
        <Image Name="Image_FanSpeedSetting_title_fan_png" HorizontalAlignment="Left" Margin="609.6,0,0,0" Source="/image/fanspeedsetting/title_fan.png" Stretch="Fill" Width="691" Height="56" />
        <Path Name="title_move" PointerPressed="title_move_PointerPressed" PointerMoved="title_move_PointerMoved" Data="M510.66635,-0.26633186 L1408.2798,0.26699932 L1409.0529,47.920679 C1379.296,61.663167 1347.4821,73.013403 1312.9944,81.254006 L608.3589,81.200006 C570.69768,71.593271 538.53856,60.18705 511.14966,47.137546" Fill="#02FFFFFF" Margin="510.667,-0.267,511.494,-0.254" Stretch="Fill" StrokeThickness="0" Cursor="SizeAll" Stroke="{x:Null}" />
        <Rectangle Name="title_icon_Copy" HorizontalAlignment="Left" Margin="0" StrokeThickness="0" Width="1920" Height="2" VerticalAlignment="Top" Fill="{Binding #title_icon.Fill}">
          <Rectangle.OpacityMask>
            <LinearGradientBrush EndPoint="0.1%,0.2%" StartPoint="99.8%,-1.1%">
              <GradientStop Color="Black" Offset="0.426" />
              <GradientStop Offset="0.992" />
              <GradientStop Color="#00181818" Offset="0.038" />
              <GradientStop Color="#FF202020" Offset="0.579" />
            </LinearGradientBrush>
          </Rectangle.OpacityMask>
        </Rectangle>
      </Grid>
    </Viewbox>
    <Viewbox Name="VB_Style" HorizontalAlignment="Right" Margin="0,0,5,0" VerticalAlignment="Top" Width="500" Height="77">
      <Grid Name="main_windowStyle" Height="78" VerticalAlignment="Top" Width="247.649" Background="#FF242424" HorizontalAlignment="Right">
        <Path Name="title_move_Copy" PointerPressed="title_move_PointerPressed" PointerMoved="title_move_PointerMoved" Data="M510.66635,-0.26633186 L1408.2798,0.26699932 L1408.0422,81.518425 C1408.0422,81.518425 506.33946,80.988292 506.33946,80.988292" Margin="-189.455,0,247.747,-0.254" Stretch="Fill" StrokeThickness="0" Cursor="SizeAll" HorizontalAlignment="Right" Width="189.357" Stroke="{x:Null}">
          <Path.Fill>
            <LinearGradientBrush EndPoint="-4%,49.5%" StartPoint="84.4%,49.8%">
              <GradientStop Color="#FF242424" Offset="0" />
              <GradientStop Color="#00242424" Offset="1" />
            </LinearGradientBrush>
          </Path.Fill>
        </Path>
        <CheckBox Name="Check_FullSrceen" Click="Check_FullSrceen_Click" Content="" Margin="0" BorderThickness="0" Theme="{StaticResource CheckBox_FullScreen}" IsChecked="True" Width="80" Height="60" Focusable="False" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand" BorderBrush="{x:Null}" Foreground="{x:Null}" Background="{Binding #title_icon.Fill}" />
        <Button Name="BTN_min" Click="BTN_min_Click" Content="" Margin="0" BorderThickness="0" Theme="{StaticResource BTN_MIN}" Width="80" HorizontalAlignment="Left" Height="60" VerticalAlignment="Center" Cursor="Hand" Focusable="False" BorderBrush="{x:Null}" Background="{Binding #title_icon.Fill}" Foreground="{x:Null}" />
        <Button Name="BTN_close" Click="BTN_close_Click" Content="" BorderThickness="0" Theme="{StaticResource S_BTN_CLOSE}" Width="80" HorizontalAlignment="Right" Height="60" VerticalAlignment="Center" Cursor="Hand" Focusable="False" BorderBrush="{x:Null}" Background="{Binding #title_icon.Fill}" Foreground="{x:Null}" />
      </Grid>
    </Viewbox>
  </Grid>
</Window>

