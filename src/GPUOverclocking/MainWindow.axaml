<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:GPUOverclocking" xmlns:UControl="using:GPUOverclocking.UControl"
  x:Class="GPUOverclocking.MainWindow" Name="window" Title="GPU Overclocking" Width="1920" Height="1080"
  WindowDecorations="None" Background="#FF000000" CanResize="True" Topmost="True" FontSize="12"
  Icon="/Image/GPUOverclocking/btn_gpu.png">
  <Border BorderThickness="0,0,1,1" BorderBrush="{Binding #Check_FullSrceen.Background}">
    <Grid>
    <Grid Margin="0">
      <Viewbox Name="VB_main" Margin="0" Width="1920" Height="1080">
        <Grid Name="_base" Height="1080" Width="1920" Background="#FF242424">
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Grid Name="grid_backgroundImage" Height="1080" Margin="0" Width="1920" IsVisible="False">
            <Image Name="bg_system_layer3" Margin="0,187.5,0,103.5" Source="/Image/Page_SystemMonitor/bg_system_layer3_3.png" Stretch="Fill" Width="1920" HorizontalAlignment="Center" />
            <Rectangle HorizontalAlignment="Left" Height="100" Margin="0,251,0,0" StrokeThickness="0" VerticalAlignment="Top" Width="500" Fill="{Binding #title_icon.Fill}" Stroke="{x:Null}">
              <Rectangle.OpacityMask>
                <ImageBrush Source="/Image/Page_SystemMonitor/bg_system_border.png" Stretch="Fill" />
              </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Name="rectangle" Height="100" Margin="0,249.666,0,0" StrokeThickness="0" VerticalAlignment="Top" RenderTransformOrigin="50%,50%" HorizontalAlignment="Right" Width="500" Fill="{Binding #title_icon.Fill}" Stroke="{x:Null}">
              <Rectangle.RenderTransform>
                <TransformGroup>
                  <ScaleTransform ScaleY="1" ScaleX="-1" />
                  <SkewTransform AngleY="0" AngleX="0" />
                  <RotateTransform Angle="0" />
                  <TranslateTransform />
                </TransformGroup>
              </Rectangle.RenderTransform>
              <Rectangle.OpacityMask>
                <ImageBrush Source="/Image/Page_SystemMonitor/bg_system_border.png" Stretch="Fill" />
              </Rectangle.OpacityMask>
            </Rectangle>
            <Rectangle Margin="0,483.2,0,0" StrokeThickness="0" Fill="{Binding #rectangle.Fill}" Stroke="{x:Null}">
              <Rectangle.OpacityMask>
                <LinearGradientBrush EndPoint="50%,100%" StartPoint="50%,0%">
                  <GradientStop Color="#4C000000" Offset="1" />
                  <GradientStop />
                </LinearGradientBrush>
              </Rectangle.OpacityMask>
            </Rectangle>
          </Grid>
          <StackPanel Name="SP_page_system_monitor" Margin="0">
            <local:Page_system_monitor Name="page_system_monitor" Height="1080" Margin="0" Width="1920" IsVisible="True" BorderBrush="{Binding #title_icon.Fill}" />
          </StackPanel>
          <Grid Name="main_menu" HorizontalAlignment="Left" Height="184" Margin="0" VerticalAlignment="Top" Width="750.067" IsVisible="False">
            <Rectangle Name="bg_main_menu" HorizontalAlignment="Left" Margin="192.2,0,0,0" StrokeThickness="0" Width="44" Height="184" Fill="{Binding #title_icon.Fill}" Stroke="{x:Null}">
              <Rectangle.OpacityMask>
                <ImageBrush Source="/Image/main/bg_main_menu_1.png" Stretch="Fill" />
              </Rectangle.OpacityMask>
            </Rectangle>
            <StackPanel Name="SP_menu" Margin="223.388,1.5,210.989,1.5" VerticalAlignment="Center">
              <StackPanel Name="SP_RBTN_SYS" Height="35" Margin="0,2,0,0">
                <RadioButton Name="RBTN_SYS" Content="System Monitor" Foreground="#FFFFFFFF" FontFamily="Microsoft Sans Serif" FontSize="18.667" VerticalContentAlignment="Center" Theme="{StaticResource RadioButton_SYS}" GroupName="main_menu" Height="35" Margin="0" Cursor="Hand" VerticalAlignment="Top" Focusable="False" BorderBrush="{x:Null}" />
              </StackPanel>
              <StackPanel Name="SP_RBTN_Basic" Height="35" Margin="0">
                <RadioButton Name="RBTN_Basic" Content="Basic Setting" Foreground="#FFFFFFFF" FontFamily="Microsoft Sans Serif" FontSize="18.667" VerticalContentAlignment="Center" Theme="{StaticResource RadioButton_SYS}" GroupName="main_menu" Margin="0" Height="35" Cursor="Hand" VerticalAlignment="Top" Focusable="False" BorderBrush="{x:Null}" />
              </StackPanel>
              <StackPanel Name="SP_RBTN_LED" Height="35" Margin="0">
                <RadioButton Name="RBTN_LED" Content="LED Device" Foreground="#FFFFFFFF" FontFamily="Microsoft Sans Serif" FontSize="18.667" VerticalContentAlignment="Center" Theme="{StaticResource RadioButton_SYS}" GroupName="main_menu" Margin="0" Height="35" Cursor="Hand" VerticalAlignment="Top" Focusable="False" BorderBrush="{x:Null}" />
              </StackPanel>
              <StackPanel Name="SP_RBTN_Extra" Height="35" Margin="0">
                <RadioButton Name="RBTN_Extra" Content="Extra Setting" Foreground="#FFFFFFFF" FontFamily="Microsoft Sans Serif" FontSize="18.667" VerticalContentAlignment="Center" Theme="{StaticResource RadioButton_SYS}" GroupName="main_menu" Margin="0" Height="35" Cursor="Hand" VerticalAlignment="Top" Focusable="False" BorderBrush="{x:Null}" />
              </StackPanel>
              <StackPanel Name="SP_RBTN_Flexikey" Height="35" Margin="0,2">
                <RadioButton Name="RBTN_FlexiKey" Content="Flexikey®" Foreground="#FFFFFFFF" FontFamily="Microsoft Sans Serif" FontSize="18.667" VerticalContentAlignment="Center" Theme="{StaticResource RadioButton_SYS}" GroupName="main_menu" Margin="0,0,1,0" Height="35" Cursor="Hand" VerticalAlignment="Top" Focusable="False" MaxHeight="314.69" HorizontalAlignment="Left" BorderBrush="{x:Null}" />
              </StackPanel>
            </StackPanel>
            <Image Name="Image_main_menu" HorizontalAlignment="Left" Margin="26.9,22.6,0,21.4" Source="/Image/main/ic_system_monitor.png" Stretch="Fill" Width="140" Height="140" />
          </Grid>
          <Grid Name="main_windowStyle_forBAT" Height="78" VerticalAlignment="Top" Width="247.649" Background="#FF242424" HorizontalAlignment="Right" Margin="0,5,5,0" IsVisible="False">
            <CheckBox Name="Check_FullSrceen1" Content="" Margin="0" BorderThickness="0" Theme="{StaticResource CheckBox_FullScreen}" IsChecked="True" Width="80" Height="60" Focusable="False" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand" IsVisible="False" BorderBrush="{x:Null}" Foreground="{x:Null}" Background="{Binding #title_icon.Fill}" />
            <Button Name="BTN_min1" Content="" Margin="0" BorderThickness="0" Theme="{StaticResource BTN_MIN}" Width="80" HorizontalAlignment="Left" Height="60" VerticalAlignment="Center" Cursor="Hand" IsVisible="False" Focusable="False" BorderBrush="{x:Null}" Background="{Binding #title_icon.Fill}" Foreground="{x:Null}" />
            <Button Name="BTN_close1" Content="" BorderThickness="0" Theme="{StaticResource S_BTN_CLOSE}" Width="80" HorizontalAlignment="Right" Height="60" VerticalAlignment="Center" Cursor="Hand" Focusable="False" BorderBrush="{x:Null}" Background="{Binding #title_icon.Fill}" Foreground="{x:Null}" />
          </Grid>
          <Grid Name="main_title_icon" HorizontalAlignment="Left" Height="81" Margin="0" VerticalAlignment="Top" Width="1920">
            <Path Name="title_move2" Data="M510.66635,-0.26633186 L1409.9492,-0.31084213 L1414.1252,81.143416 C1414.1252,81.143416 512.34961,81.187468 512.34961,81.187468" Fill="#02242424" Stretch="Fill" StrokeThickness="0" Cursor="SizeAll" HorizontalAlignment="Left" Width="1920" Margin="0,0,0,0.2" Stroke="{x:Null}" />
            <Rectangle Name="title_icon" Margin="503.667,2.254,506.333,-0.254" StrokeThickness="0" Height="79" Fill="#FFFF00D2" Stroke="{Binding #title_icon.Fill}">
              <Rectangle.OpacityMask>
                <ImageBrush Source="/Image/main/bg_title_bar_3.png" Stretch="Fill" />
              </Rectangle.OpacityMask>
            </Rectangle>
            <Image Name="Image_FanSpeedSetting_title_fan_png" HorizontalAlignment="Left" Margin="609.6,0,0,0" Source="/Image/GPUOverclocking/title_gpu.png" Stretch="Fill" Width="691" Height="56" />
            <Path Name="title_move" Data="M510.66635,-0.26633186 L1408.2798,0.26699932 L1409.0529,47.920679 C1379.296,61.663167 1347.4821,73.013403 1312.9944,81.254006 L608.3589,81.200006 C570.69768,71.593271 538.53856,60.18705 511.14966,47.137546" Fill="#02FFFFFF" Margin="510.667,-0.267,511.494,-0.254" Stretch="Fill" StrokeThickness="0" Cursor="SizeAll" Stroke="{x:Null}" />
            <Rectangle Name="title_icon_Copy" HorizontalAlignment="Left" Margin="0" StrokeThickness="0" Width="1920" Height="2" VerticalAlignment="Top" Fill="{Binding #title_icon.Fill}">
              <Rectangle.OpacityMask>
                <LinearGradientBrush EndPoint="0.1%,0.2%" StartPoint="99.8%,-1.1%">
                  <GradientStop Color="Black" Offset="0.426" />
                  <GradientStop Offset="0.992" />
                  <GradientStop Color="#00181818" Offset="0.038" />
                  <GradientStop Color="#FF202020" Offset="0.579" />
                </LinearGradientBrush>
              </Rectangle.OpacityMask>
            </Rectangle>
          </Grid>
          <UControl:UserControl_DialogBox Name="UC_DialogBox" Margin="0" IsVisible="False" />
        </Grid>
      </Viewbox>
      <Viewbox Name="VB_Style" HorizontalAlignment="Right" Margin="0,5,5,0" VerticalAlignment="Top" Width="500" Height="77">
        <Grid Name="main_windowStyle" Height="78" VerticalAlignment="Top" Width="247.649" Background="#FF242424" HorizontalAlignment="Right">
          <Path Name="title_move_Copy" Data="M510.66635,-0.26633186 L1408.2798,0.26699932 L1408.0422,81.518425 C1408.0422,81.518425 506.33946,80.988292 506.33946,80.988292" Margin="-189.455,0,247.747,-0.254" Stretch="Fill" StrokeThickness="0" Cursor="SizeAll" HorizontalAlignment="Right" Width="189.357" Stroke="{x:Null}">
            <Path.Fill>
              <LinearGradientBrush EndPoint="-4%,49.5%" StartPoint="84.4%,49.8%">
                <GradientStop Color="#FF242424" Offset="0" />
                <GradientStop Color="#00242424" Offset="1" />
              </LinearGradientBrush>
            </Path.Fill>
          </Path>
          <CheckBox Name="Check_FullSrceen" Content="" Margin="0" BorderThickness="0" Theme="{StaticResource CheckBox_FullScreen}" IsChecked="True" Width="80" Height="60" Focusable="False" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand" BorderBrush="{x:Null}" Foreground="{x:Null}" Background="{Binding #title_icon.Fill}" />
          <Button Name="BTN_min" Content="" Margin="0" BorderThickness="0" Theme="{StaticResource BTN_MIN}" Width="80" HorizontalAlignment="Left" Height="60" VerticalAlignment="Center" Cursor="Hand" Focusable="False" BorderBrush="{x:Null}" Background="{Binding #title_icon.Fill}" Foreground="{x:Null}" />
          <Button Name="BTN_close" Content="" BorderThickness="0" Theme="{StaticResource S_BTN_CLOSE}" Width="80" HorizontalAlignment="Right" Height="60" VerticalAlignment="Center" Cursor="Hand" Focusable="False" BorderBrush="{x:Null}" Background="{Binding #title_icon.Fill}" Foreground="{x:Null}" />
        </Grid>
      </Viewbox>
    </Grid>

    <Path Name="grip" Data="M11,1 L1,11 M11,5 L5,11 M11,9 L9,11" Stroke="#FFB1B1B1" StrokeThickness="1" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="BottomRightCorner" Fill="Transparent" />
    </Grid>
  </Border>
</Window>
