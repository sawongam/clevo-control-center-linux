        </Rectangle>
        <Rectangle Name="system_temperature_layer2" Fill="#FFFFFFFF" Margin="0" Width="504" Height="504" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="50%,50%">
          <Rectangle.RenderTransform>
