        </TextBlock>
        <TextBlock Name="T_2" HorizontalAlignment="Left" Height="25" Margin="302,46,0,0" TextWrapping="Wrap" Text="80" VerticalAlignment="Top" Width="29" Foreground="#FFFFFFFF" FontSize="22" FontFamily="Microsoft Sans Serif" RenderTransformOrigin="50%,50%">
          <TextBlock.RenderTransform>
