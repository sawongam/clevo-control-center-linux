      </Grid>
      <Grid Name="Info_Clock" Margin="0" VerticalAlignment="Top" Height="642.4">
        <Image Name="Image_Page_SystemMonitor_clock_clock_dotted_line_png" Margin="364.6,12.4,0,0" Source="/Image/Page_SystemMonitor/clock/clock_dotted_line_2.png" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top" Width="1181" Height="518" IsVisible="False" />
