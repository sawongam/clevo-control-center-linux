<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:GPUOverclocking" xmlns:UControl="using:GPUOverclocking.UControl"
  x:Class="GPUOverclocking.Page_system_monitor" Name="userControl" Width="1920" Height="1080" BorderBrush="#FFFF0000" FontSize="12">
  <UserControl.Styles>
    <Style Selector="ComboBoxItem">
      <Setter Property="Foreground" Value="#FFFFFFFF" />
      <Setter Property="Padding" Value="4,1" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Name="PART_ContentPresenter" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" Content="{TemplateBinding Content}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="Center" />
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#1F26A0DA" /></Style>
    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="#3D26A0DA" /></Style>
  </UserControl.Styles>

    <Grid Name="page_system_monitor" Width="1920" Height="1080">
      <Rectangle Margin="0,0,0,-2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="1920" Height="1080" Fill="{Binding #userControl.BorderBrush}">
        <Rectangle.OpacityMask>
          <ImageBrush Source="/Image/FanSpeedSetting/bg_fan_layer2.png" Stretch="Fill" />
        </Rectangle.OpacityMask>
      </Rectangle>
      <Rectangle Margin="0,0,0,-2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="1920" Height="1080">
        <Rectangle.Fill>
          <ImageBrush Source="/Image/FanSpeedSetting/bg_fan_less_layer3.png" Stretch="Fill" />
        </Rectangle.Fill>
      </Rectangle>
      <Rectangle Margin="0,0,0,-2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="1920" Height="1080">
        <Rectangle.Fill>
          <ImageBrush Source="/Image/GPUOverclocking/bg_cpu_layer3.png" Stretch="Fill" />
        </Rectangle.Fill>
      </Rectangle>
      <Rectangle Name="R2" Margin="0,0,0,-2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="1920" Height="1080" Fill="{Binding #userControl.BorderBrush}">
        <Rectangle.OpacityMask>
          <ImageBrush Source="/Image/GPUOverclocking/bg_clock_layer2.png" Stretch="Fill" />
        </Rectangle.OpacityMask>
      </Rectangle>
      <Rectangle Name="R3" Margin="0,0,0,-2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="1920" Height="1080">
        <Rectangle.Fill>
          <ImageBrush Source="/Image/GPUOverclocking/bg_clock_layer3.png" Stretch="Fill" />
        </Rectangle.Fill>
      </Rectangle>
      <Rectangle Name="R4" Margin="0,0,0,-2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="1920" Height="1080" Fill="{Binding #userControl.BorderBrush}">
        <Rectangle.OpacityMask>
          <ImageBrush Source="/Image/GPUOverclocking/bg_clock_layer4.png" Stretch="Fill" />
        </Rectangle.OpacityMask>
      </Rectangle>
      <UControl:UserControl_CoreClock Name="UC_GPUCoreClock" Width="770" Margin="0,254,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" BorderBrush="{Binding #info_GPU.Foreground}" />
      <Rectangle Name="R5" Margin="0,0,0,-2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="1920" Height="1080">
        <Rectangle.Fill>
          <ImageBrush Source="/Image/GPUOverclocking/bg_gpu_clock_layer5.png" Stretch="Fill" />
        </Rectangle.Fill>
      </Rectangle>
      <Rectangle Name="bg_system_info_dgpu" HorizontalAlignment="Right" Height="343" Margin="0,0,35,56.432" StrokeThickness="0" VerticalAlignment="Bottom" Width="398" IsVisible="False" Fill="{Binding #bg_system_setting_tab.Fill}" Stroke="{x:Null}">
        <Rectangle.OpacityMask>
          <ImageBrush Source="/Image/Page_SystemMonitor/bg_system_info_dgpu.png" Stretch="Fill" />
        </Rectangle.OpacityMask>
      </Rectangle>
      <Rectangle Name="bg_system_setting_tab" Height="127" Margin="391.267,0,390.732,-50.168" StrokeThickness="0" VerticalAlignment="Bottom" Width="1138" IsVisible="False" Fill="{Binding #userControl.BorderBrush}" Stroke="{x:Null}">
        <Rectangle.OpacityMask>
          <ImageBrush Source="/Image/Page_SystemMonitor/bg_system_setting_tab.png" Stretch="Fill" />
        </Rectangle.OpacityMask>
      </Rectangle>
      <Rectangle Name="bg_system_setting_tab_shadow" Margin="391.267,0,390.732,-50.168" StrokeThickness="0" Width="1138" Height="127" VerticalAlignment="Bottom" Fill="#FF000000" IsVisible="False" Stroke="{x:Null}">
        <Rectangle.OpacityMask>
          <ImageBrush Source="/Image/Page_SystemMonitor/bg_system_setting_tab_shadow.png" Stretch="Fill" />
        </Rectangle.OpacityMask>
      </Rectangle>
      <Grid Name="info_FAN_CPU" HorizontalAlignment="Left" Margin="300,140,0,0" Width="568" Height="568" VerticalAlignment="Top" IsVisible="False">
        <Rectangle Name="system_temperature_layer5" Margin="0" Width="568" Height="568" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="50%,50%" Fill="{Binding #userControl.BorderBrush}">
          <Rectangle.RenderTransform>
            <TransformGroup>
              <ScaleTransform ScaleY="1" ScaleX="1" />
              <SkewTransform AngleY="0" AngleX="0" />
              <RotateTransform Angle="90" />
              <TranslateTransform />
            </TransformGroup>
          </Rectangle.RenderTransform>
          <Rectangle.OpacityMask>
            <ImageBrush Source="/Image/Page_SystemMonitor/Temp/system_temperature_layer1_1.png" Stretch="Fill" />
          </Rectangle.OpacityMask>
        </Rectangle>
        <Rectangle Name="system_temperature_layer6" Fill="#FFFFFFFF" Margin="0" Width="568" Height="568" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="50%,50%">
          <Rectangle.RenderTransform>
            <TransformGroup>
              <ScaleTransform ScaleY="1" ScaleX="1" />
              <SkewTransform AngleY="0" AngleX="0" />
              <RotateTransform Angle="89.5" />
              <TranslateTransform />
            </TransformGroup>
          </Rectangle.RenderTransform>
          <Rectangle.OpacityMask>
            <ImageBrush Source="/Image/Page_SystemMonitor/Temp/system_temperature_layer2_2.png" Stretch="Fill" />
          </Rectangle.OpacityMask>
        </Rectangle>
        <Image Name="Image_Page_SystemMonitor_system_gpu_temperature_layer3_png2" Margin="0" Source="/Image/FanSpeedSetting/system_fan_layer3_1.png" Stretch="Fill" Height="88" Width="88" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <TextBlock Name="T_7" HorizontalAlignment="Left" Height="20" Margin="423,106,0,0" TextWrapping="Wrap" Text="100" VerticalAlignment="Top" Width="39" Foreground="#FFFFFFFF" FontSize="22" FontFamily="Microsoft Sans Serif" />
        <TextBlock Name="T_8" HorizontalAlignment="Left" Height="20" Margin="304,46,0,0" TextWrapping="Wrap" Text="80" VerticalAlignment="Top" Width="29" Foreground="#FFFFFFFF" FontSize="22" FontFamily="Microsoft Sans Serif" />
        <TextBlock Name="T_9" HorizontalAlignment="Left" Height="20" Margin="160,0,0,479" TextWrapping="Wrap" Text="60" VerticalAlignment="Bottom" Width="29" Foreground="#FFFFFFFF" FontSize="22" FontFamily="Microsoft Sans Serif" />
        <TextBlock Name="T_10" HorizontalAlignment="Left" Height="20" Margin="66,0,0,380" TextWrapping="Wrap" Text="40" VerticalAlignment="Bottom" Width="29" Foreground="#FFFFFFFF" FontSize="22" FontFamily="Microsoft Sans Serif" />
        <TextBlock Name="T_11" HorizontalAlignment="Left" Height="20" Margin="48,0,0,240" TextWrapping="Wrap" Text="20" VerticalAlignment="Bottom" Width="29" Foreground="#FFFFFFFF" FontSize="22" FontFamily="Microsoft Sans Serif" />
        <TextBlock Name="T_12" HorizontalAlignment="Left" Height="20" Margin="108,0,0,111" TextWrapping="Wrap" Text="0" VerticalAlignment="Bottom" Width="29" Foreground="#FFFFFFFF" FontSize="22" FontFamily="Microsoft Sans Serif" />
        <TextBlock Name="T_FanSpeed" Height="34" Margin="165,344,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Foreground="#FFFFFFFF" FontSize="22" FontFamily="Microsoft Sans Serif" HorizontalAlignment="Left" Width="246" TextAlignment="Center" Text="{Binding #F_speed.Text}" />
        <Rectangle Name="CPUFAN_needle_layer3" Margin="0" RenderTransformOrigin="50%,50%" Width="568" Height="568" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{Binding #system_temperature_layer5.Fill}">
          <Rectangle.RenderTransform>
            <TransformGroup>
              <ScaleTransform />
              <SkewTransform />
              <RotateTransform Angle="225" />
              <TranslateTransform />
            </TransformGroup>
          </Rectangle.RenderTransform>
          <Rectangle.OpacityMask>
            <ImageBrush Source="/Image/Page_SystemMonitor/Temp/system_temperature_needle_layer1_2.png" Stretch="Fill" />
          </Rectangle.OpacityMask>
        </Rectangle>
        <Rectangle Name="CPUFAN_needle_layer4" Fill="#FFFFFFFF" Margin="0" Width="568" Height="568" RenderTransformOrigin="50%,50%" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Rectangle.RenderTransform>
            <TransformGroup>
              <ScaleTransform ScaleY="1" ScaleX="1" />
              <SkewTransform AngleY="0" AngleX="0" />
              <RotateTransform Angle="225" />
              <TranslateTransform />
            </TransformGroup>
          </Rectangle.RenderTransform>
          <Rectangle.OpacityMask>
            <ImageBrush Source="/Image/Page_SystemMonitor/Temp/system_temperature_needle_layer2_2.png" Stretch="Fill" />
          </Rectangle.OpacityMask>
        </Rectangle>
        <TextBlock Name="T_unit2" Height="25" Margin="342,193,0,0" TextWrapping="Wrap" Text="%" VerticalAlignment="Top" Foreground="#FFFFFFFF" FontSize="24" FontFamily="Microsoft Sans Serif" HorizontalAlignment="Left" Width="29" />
        <TextBlock Name="CPUFan_value1" Margin="225,171,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Foreground="#FFFFFFFF" FontSize="48" FontFamily="Microsoft Sans Serif" HorizontalAlignment="Left" Width="115" TextAlignment="Center" Height="55" Text="100" />
        <TextBlock Name="F_RPM_Copy" Margin="0,0,195.6,63.8" TextWrapping="Wrap" Text="RPM" Foreground="#FFFFFFFF" FontSize="20" FontFamily="Microsoft Sans Serif" HorizontalAlignment="Right" Width="53" Height="20" VerticalAlignment="Bottom" />
        <TextBlock Name="T_GPUFan_RPM_value_Copy" Margin="0,470.2,259.6,57.8" TextWrapping="Wrap" Foreground="#FFFFFFFF" FontSize="36" FontFamily="Microsoft Sans Serif" TextAlignment="Right" HorizontalAlignment="Right" Width="94" Text="{Binding #T_CPUFan_RPM_value.Text}" />
      </Grid>
      <Grid Name="info_temp_fan_gpu" HorizontalAlignment="Right" Margin="0,0,55,260" Width="504" Height="504" VerticalAlignment="Bottom">
        <TextBlock Name="info_GPU" Margin="-142.6,0,617.6,489.6" TextWrapping="Wrap" Text="GPU" Foreground="#FF00A8FF" FontSize="40" FontFamily="Microsoft Sans Serif" TextAlignment="Right" Height="46" VerticalAlignment="Bottom" IsVisible="False" />
        <Rectangle Name="system_temperature_layer1" Margin="0" Width="504" Height="504" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="50%,50%" Fill="{Binding #info_GPU.Foreground}">
          <Rectangle.RenderTransform>
            <TransformGroup>
              <ScaleTransform ScaleY="1" ScaleX="-1" />
              <SkewTransform AngleY="0" AngleX="0" />
              <RotateTransform Angle="0" />
