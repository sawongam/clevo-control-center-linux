        <TextBlock Name="T_1" HorizontalAlignment="Left" Height="25" Margin="433,111,0,0" TextWrapping="Wrap" Text="100" VerticalAlignment="Top" Width="39" Foreground="#FFFFFFFF" FontSize="22" FontFamily="Microsoft Sans Serif" RenderTransformOrigin="50%,50%">
          <TextBlock.RenderTransform>
            <TransformGroup>
              <ScaleTransform ScaleY="1" ScaleX="-1" />
              <SkewTransform AngleY="0" AngleX="0" />
              <RotateTransform Angle="0" />
