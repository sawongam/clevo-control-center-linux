        </Rectangle>
        <Image Name="Image_Page_SystemMonitor_system_gpu_temperature_layer3_png" Margin="0" Source="/Image/Page_SystemMonitor/Temp/system_gpu_temperature_layer3_1.png" Stretch="Fill" Height="78" Width="78" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <TextBlock Name="T_100" HorizontalAlignment="Left" Height="24" Margin="374.2,90,0,0" TextWrapping="Wrap" Text="100" VerticalAlignment="Top" Width="39" Foreground="#FFFFFFFF" FontSize="22" FontFamily="Microsoft Sans Serif" />
        <TextBlock Name="T_80" HorizontalAlignment="Left" Height="22.8" Margin="452,204.4,0,0" TextWrapping="Wrap" Text="80" VerticalAlignment="Top" Width="29" Foreground="#FFFFFFFF" FontSize="22" FontFamily="Microsoft Sans Serif" />
        <TextBlock Name="T_60" HorizontalAlignment="Right" Height="22.4" Margin="0,0,47.4,138.2" TextWrapping="Wrap" Text="60" VerticalAlignment="Bottom" Width="29" Foreground="#FFFFFFFF" FontSize="22" FontFamily="Microsoft Sans Serif" />
        <TextBlock Name="T_40" HorizontalAlignment="Right" Height="20" Margin="0,0,137.4,49.6" TextWrapping="Wrap" Text="40" VerticalAlignment="Bottom" Width="29" Foreground="#FFFFFFFF" FontSize="22" FontFamily="Microsoft Sans Serif" />
        <TextBlock Name="T_20" HorizontalAlignment="Left" Height="20" Margin="205.6,0,0,30.933" TextWrapping="Wrap" Text="20" VerticalAlignment="Bottom" Width="29" Foreground="#FFFFFFFF" FontSize="22" FontFamily="Microsoft Sans Serif" />
        <TextBlock Name="T_0" HorizontalAlignment="Left" Height="20" Margin="90.4,0,0,92.6" TextWrapping="Wrap" Text="0" VerticalAlignment="Bottom" Width="29" Foreground="#FFFFFFFF" FontSize="22" FontFamily="Microsoft Sans Serif" />
        <TextBlock Name="T_temp" Height="34" Margin="151.667,304,0,0" TextWrapping="Wrap" Text="Temperature" VerticalAlignment="Top" Foreground="#FFFFFFFF" FontSize="18.667" FontFamily="Microsoft Sans Serif" HorizontalAlignment="Left" Width="201.2" TextAlignment="Center" />
        <Rectangle Name="GPUTemp_needle_layer1" Margin="0" RenderTransformOrigin="50%,50%" Width="504" Height="504" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{Binding #info_GPU.Foreground}">
          <Rectangle.RenderTransform>
            <TransformGroup>
              <ScaleTransform ScaleY="1" ScaleX="-1" />
              <SkewTransform AngleY="0" AngleX="0" />
              <RotateTransform Angle="-135" />
              <TranslateTransform />
            </TransformGroup>
          </Rectangle.RenderTransform>
          <Rectangle.OpacityMask>
            <ImageBrush Source="/Image/GPUOverclocking/gauge_cpu_needle_layer1.png" Stretch="Fill" />
          </Rectangle.OpacityMask>
        </Rectangle>
        <Rectangle Name="GPUTemp_needle_layer2" Fill="#FFFFFFFF" Margin="0" Width="504" Height="504" RenderTransformOrigin="50%,50%" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Rectangle.RenderTransform>
            <TransformGroup>
              <ScaleTransform ScaleY="1" ScaleX="-1" />
              <SkewTransform AngleY="0" AngleX="0" />
              <RotateTransform Angle="-135" />
              <TranslateTransform />
            </TransformGroup>
          </Rectangle.RenderTransform>
          <Rectangle.OpacityMask>
            <ImageBrush Source="/Image/Page_SystemMonitor/Temp/system_temperature_needle_layer2_2.png" Stretch="Fill" />
          </Rectangle.OpacityMask>
        </Rectangle>
        <TextBlock Name="T_unit" Height="37.8" Margin="318.8,69,0,0" TextWrapping="Wrap" Text="°C" VerticalAlignment="Top" Foreground="#FFFFFFFF" FontSize="32" FontFamily="Microsoft Sans Serif" HorizontalAlignment="Left" Width="43.4" />
        <TextBlock Name="GPUTemp_value" Margin="196.2,143.8,0,0" TextWrapping="Wrap" Text="OFF" VerticalAlignment="Top" Foreground="#FFFFFFFF" FontSize="48" FontFamily="Microsoft Sans Serif" HorizontalAlignment="Left" Width="115" TextAlignment="Center" Height="55" />
      </Grid>
      <Grid Name="info_temp_fan_cpu" HorizontalAlignment="Right" Margin="0,140,300,0" Width="568" RenderTransformOrigin="50%,50%" Height="568" VerticalAlignment="Top" IsVisible="False">
        <Grid.RenderTransform>
          <TransformGroup>
            <ScaleTransform ScaleY="1" ScaleX="-1" />
            <SkewTransform AngleY="0" AngleX="0" />
            <RotateTransform Angle="0" />
            <TranslateTransform />
          </TransformGroup>
        </Grid.RenderTransform>
        <Rectangle Name="system_temperature_layer3" Margin="0" Width="568" Height="568" RenderTransformOrigin="50%,50%" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{Binding #userControl.BorderBrush}">
          <Rectangle.RenderTransform>
            <TransformGroup>
              <ScaleTransform />
              <SkewTransform />
              <RotateTransform Angle="90" />
              <TranslateTransform />
            </TransformGroup>
          </Rectangle.RenderTransform>
          <Rectangle.OpacityMask>
            <ImageBrush Source="/Image/Page_SystemMonitor/Temp/system_temperature_layer1_1.png" Stretch="Fill" />
          </Rectangle.OpacityMask>
        </Rectangle>
        <Rectangle Name="system_temperature_layer4" Fill="#FFFFFFFF" Margin="0" Width="568" Height="568" RenderTransformOrigin="50%,50%" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Rectangle.RenderTransform>
            <TransformGroup>
              <ScaleTransform />
              <SkewTransform />
              <RotateTransform Angle="90" />
              <TranslateTransform />
            </TransformGroup>
          </Rectangle.RenderTransform>
          <Rectangle.OpacityMask>
            <ImageBrush Source="/Image/Page_SystemMonitor/Temp/system_temperature_layer2_2.png" Stretch="Fill" />
          </Rectangle.OpacityMask>
        </Rectangle>
        <Image Name="Image_Page_SystemMonitor_system_gpu_temperature_layer3_png1" Margin="0" Source="/Image/Page_SystemMonitor/Temp/system_cpu_temperature_layer3_1.png" Stretch="Fill" Height="88" Width="88" RenderTransformOrigin="50%,50%" HorizontalAlignment="Center" VerticalAlignment="Center">
