          <TextBlock Name="T_Dialog_info" TextWrapping="Wrap" Text="Activating CPU Overclock may reduce system stability, useful life of the system and affect system data integrity." Foreground="#FFFFFFFF" FontFamily="Microsoft Sans Serif" FontSize="26.667" HorizontalAlignment="Center" VerticalAlignment="Center" Width="660" Canvas.Left="710" Canvas.Top="420" />
