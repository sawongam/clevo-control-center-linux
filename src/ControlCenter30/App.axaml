<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ControlCenter30.App" RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>
  <Application.Resources>
    <!-- Window1.xaml implicit ToolTip style (OverridesDefaultStyle + custom template) -->
    <ControlTheme TargetType="ToolTip" x:Key="{x:Type ToolTip}">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="Border" BorderThickness="1" BorderBrush="#FF363636" CornerRadius="4">
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="White" />
                <GradientStop Color="#FFFFF0CC" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
            <ContentPresenter Margin="4" HorizontalAlignment="Left" VerticalAlignment="Top" Content="{TemplateBinding Content}" TextElement.FontFamily="Microsoft Sans Serif" TextElement.FontSize="18.667" TextElement.Foreground="#FF000000" />
          </Border>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </Application.Resources>
</Application>
