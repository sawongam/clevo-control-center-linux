    <ControlTheme TargetType="CheckBox" x:Key="CheckBoxStyle_new">
      <Setter Property="Background" Value="{StaticResource OptionMark.Static.Background}" />
      <Setter Property="BorderBrush" Value="{StaticResource OptionMark.Static.Border}" />
      <Setter Property="Foreground" Value="#FF000000" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Name="templateRoot" Background="#00FFFFFF">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Height="46" Margin="0" VerticalAlignment="Center" Width="46">
              <Rectangle Name="rectangle_Copy" Margin="0" Width="46" Height="46" StrokeThickness="0" Fill="#FF575757" Stroke="{x:Null}">
                <Rectangle.OpacityMask>
                  <ImageBrush Source="/image/btn_enable.png" />
                </Rectangle.OpacityMask>
              </Rectangle>
              <Rectangle Name="rectangle" Margin="0" Width="46" Height="46" StrokeThickness="0" Fill="{TemplateBinding Background}" Stroke="{x:Null}">
                <Rectangle.OpacityMask>
                  <ImageBrush Source="/image/btn_enable.png" />
                </Rectangle.OpacityMask>
              </Rectangle>
            </Grid>
            <TextBlock Name="textBlock" Grid.Column="1" Margin="0" TextWrapping="Wrap" Text="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="#FFB4B4B4" FontSize="20" FontFamily="Microsoft Sans Serif" />
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:disabled /template/ Rectangle#rectangle">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="^:disabled /template/ TextBlock#textBlock">
        <Setter Property="Foreground" Value="#FFB4B4B4" />
      </Style>
      <Style Selector="^:checked:disabled /template/ Rectangle#rectangle">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="^:checked:disabled /template/ Rectangle#rectangle_Copy">
        <Setter Property="OpacityMask">
          <ImageBrush Source="/image/btn_disable.png" />
        </Setter>
      </Style>
      <Style Selector="^:not(:checked):not(:disabled) /template/ TextBlock#textBlock">
        <Setter Property="Foreground" Value="#FFB4B4B4" />
      </Style>
      <Style Selector="^:not(:checked):not(:disabled) /template/ Rectangle#rectangle">
        <Setter Property="OpacityMask">
          <ImageBrush Source="/image/btn_enable.png" />
        </Setter>
      </Style>
      <Style Selector="^:not(:checked):not(:disabled) /template/ Rectangle#rectangle_Copy">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <Style Selector="^:checked:not(:disabled) /template/ TextBlock#textBlock">
        <Setter Property="Foreground" Value="#FFFFFFFF" />
      </Style>
      <Style Selector="^:checked:not(:disabled) /template/ Rectangle#rectangle">
        <Setter Property="OpacityMask">
          <ImageBrush Source="/image/btn_disable.png" />
        </Setter>
        <Setter Property="IsVisible" Value="True" />
      </Style>
    </ControlTheme>
    <ControlTheme TargetType="ComboBox" x:Key="ComboBoxStyle1">
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Name="templateRoot">
            <Rectangle Margin="-6.834,-16.833,-39.166,-15.167" StrokeThickness="0" HorizontalAlignment="Left" Width="149" Fill="{Binding #BTN_close.Background}">
              <Rectangle.OpacityMask>
                <ImageBrush Source="/image/btn_gpu_setting_dropdown.png" />
              </Rectangle.OpacityMask>
            </Rectangle>
            <ContentControl Name="contentPresenter" Content="{TemplateBinding SelectionBoxItem}" IsHitTestVisible="False" Margin="0,3,20,0" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
            <ToggleButton Name="toggleButton" Background="Transparent" BorderThickness="0" Focusable="False" ClickMode="Press" Opacity="0.01" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsChecked="{TemplateBinding IsDropDownOpen, Mode=TwoWay}" />
            <Popup Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}" MaxHeight="{TemplateBinding MaxDropDownHeight}" PlacementTarget="templateRoot" IsLightDismissEnabled="True" Width="126" Placement="Bottom">
              <Border Background="#FF272727" BorderThickness="0">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Height="150">
                  <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme TargetType="ComboBoxItem" x:Key="{x:Type ComboBoxItem}">
      <Setter Property="Foreground" Value="#FFFFFFFF" />
      <Setter Property="Padding" Value="4,3" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Name="PART_ContentPresenter" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" Content="{TemplateBinding Content}" />
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#FF3A3A3A" /></Style>
      <Style Selector="^:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#FF4A4A4A" /></Style>
    </ControlTheme>
  </Window.Resources>
