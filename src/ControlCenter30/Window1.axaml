    <SolidColorBrush x:Key="Button.Static.Background" Color="#FFDDDDDD" />
    <SolidColorBrush x:Key="Button.Static.Border" Color="#FF707070" />
    <ControlTheme TargetType="Button" x:Key="Btn_back">
      <Setter Property="Background" Value="{StaticResource Button.Static.Background}" />
      <Setter Property="BorderBrush" Value="{StaticResource Button.Static.Border}" />
      <Setter Property="Foreground" Value="#FF000000" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="1" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
            <Image Name="image" Margin="0" Source="/image/btn_back_normal.png" Stretch="Fill" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ Image#image">
        <Setter Property="Source" Value="/image/btn_back_hover.png" />
      </Style>
      <Style Selector="^:pressed /template/ Image#image">
        <Setter Property="Source" Value="/image/btn_back_pressed.png" />
      </Style>
    </ControlTheme>
    <SolidColorBrush x:Key="OptionMark.Static.Background" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="OptionMark.Static.Border" Color="#FF707070" />
    <ControlTheme TargetType="CheckBox" x:Key="CheckBoxStyle2">
      <Setter Property="Background" Value="{StaticResource OptionMark.Static.Background}" />
      <Setter Property="BorderBrush" Value="{StaticResource OptionMark.Static.Border}" />
      <Setter Property="Foreground" Value="#FF000000" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Name="templateRoot" Background="#00FFFFFF">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Height="46" Margin="0" VerticalAlignment="Center" Width="46">
              <Rectangle Name="rectangle_Copy" Margin="0" Width="46" Height="46" StrokeThickness="0" Fill="#FF575757" Stroke="{x:Null}">
                <Rectangle.OpacityMask>
                  <ImageBrush Source="/image/btn_enable.png" />
                </Rectangle.OpacityMask>
              </Rectangle>
              <Rectangle Name="rectangle" Margin="0" Width="46" Height="46" StrokeThickness="0" Fill="{TemplateBinding Background}" Stroke="{x:Null}">
                <Rectangle.OpacityMask>
                  <ImageBrush Source="/image/btn_enable.png" />
                </Rectangle.OpacityMask>
              </Rectangle>
            </Grid>
            <TextBlock Name="textBlock" Grid.Column="1" Margin="0" TextWrapping="Wrap" Text="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="#FFB4B4B4" FontSize="24" FontFamily="Microsoft Sans Serif" />
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:disabled /template/ Rectangle#rectangle">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="^:disabled /template/ TextBlock#textBlock">
        <Setter Property="Foreground" Value="#FFB4B4B4" />
      </Style>
      <Style Selector="^:not(:checked):not(:disabled) /template/ TextBlock#textBlock">
        <Setter Property="Foreground" Value="#FFB4B4B4" />
      </Style>
      <Style Selector="^:not(:checked):not(:disabled) /template/ Rectangle#rectangle">
        <Setter Property="OpacityMask">
          <ImageBrush Source="/image/btn_enable.png" />
        </Setter>
      </Style>
      <Style Selector="^:not(:checked):not(:disabled) /template/ Rectangle#rectangle_Copy">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <Style Selector="^:checked:not(:disabled) /template/ TextBlock#textBlock">
        <Setter Property="Foreground" Value="#FFFFFFFF" />
      </Style>
      <Style Selector="^:checked:not(:disabled) /template/ Rectangle#rectangle">
        <Setter Property="OpacityMask">
          <ImageBrush Source="/image/btn_disable.png" />
        </Setter>
        <Setter Property="IsVisible" Value="True" />
      </Style>
    </ControlTheme>
    <ControlTheme TargetType="Button" x:Key="ButtonStyle_APP">
      <Setter Property="Background" Value="{StaticResource Button.Static.Background}" />
      <Setter Property="BorderBrush" Value="{StaticResource Button.Static.Border}" />
      <Setter Property="Foreground" Value="#FF000000" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="1" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Margin="0" ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <Rectangle Name="R_BR" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.6" StrokeDashArray="1,2,1,2" Margin="5,0,0,0" Fill="#02000000" />
            <Rectangle Name="R_image" StrokeThickness="2" StrokeDashArray="1,2,1,2" Margin="5,0,0,0" Width="140" Height="140" Fill="{TemplateBinding Background}" IsVisible="False" />
            <Image Name="App" Height="140" Width="140" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="False" Source="/image/btn_disable.png" />
            <TextBlock Name="textBlock" HorizontalAlignment="Stretch" Margin="0,200,0,0" TextWrapping="Wrap" VerticalAlignment="Center" TextAlignment="Center" Text="{TemplateBinding Tag}" />
            <ContentPresenter HorizontalAlignment="Center" Height="140" Margin="0" VerticalAlignment="Center" Width="140" Content="{TemplateBinding Content}" />
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ Rectangle#R_BR">
        <Setter Property="Fill">
          <LinearGradientBrush EndPoint="50%,100%" StartPoint="50%,0%">
            <GradientStop Color="Transparent" Offset="0" />
            <GradientStop Color="#19FFFFFF" Offset="1" />
          </LinearGradientBrush>
        </Setter>
      </Style>
      <Style Selector="^:pressed /template/ Rectangle#R_BR">
        <Setter Property="Fill" Value="#4C000000" />
      </Style>
    </ControlTheme>
