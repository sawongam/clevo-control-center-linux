<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../VERSION').Trim())</Version>
    <Authors>ccenter contributors</Authors>
    <PackageLicenseExpression>GPL-2.0-only</PackageLicenseExpression>
    <AvaloniaVersion>12.1.6</AvaloniaVersion>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <!-- Ported (decompiler-style) code: unused variables/fields, unreachable code, vendor type names, etc. -->
    <NoWarn>$(NoWarn);CS0168;CS0219;CS0414;CS0649;CS0169;CS0162;CS0067;CS0105;CS0675;CS8632;CS8981;CA1416</NoWarn>
  </PropertyGroup>
</Project>
