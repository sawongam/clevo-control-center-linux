      <ControlTheme x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Template">
          <ControlTemplate>
            <Grid Margin="0">
              <Border
                  Name="templateRoot"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Background="{TemplateBinding Background}"
                  Margin="0"
                  Opacity="0.01"
                  BorderBrush="{StaticResource ComboBox.Static.Border}"
                  OpacityMask="{x:Null}"
                >
                <Border
                    Name="splitBorder"
                    Margin="0"
                    HorizontalAlignment="Stretch"
                    BorderThickness="0"
                    BorderBrush="#00FFFFFF"
                  >
                  <Path Name="arrow" VerticalAlignment="Center" IsVisible="True" Margin="0" HorizontalAlignment="Center" Data="F1 M0,0 L2.667,2.66665 L5.3334,0 L5.3334,-1.78168 L2.6667,0.88501 L0,-1.78168 L0,0" Fill="{Binding #templateRoot.Background}" />
                </Border>
              </Border>
              <Rectangle Margin="0" StrokeThickness="0" Fill="{Binding #templateRoot.Background}">
                <Rectangle.OpacityMask>
                  <ImageBrush Source="/image/page_systemmonitor/memsetting/btn_mem_setting_dropdown_on.png" />
                </Rectangle.OpacityMask>
              </Rectangle>
              <Rectangle Margin="0" StrokeThickness="1.5" Fill="{x:Null}" Stroke="{Binding #templateRoot.Background}" />
            </Grid>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:disabled">
          <Setter Property="Foreground" Value="#FF7D7D7D" />
        </Style>
        <Style Selector="^:not(:disabled)">
          <Setter Property="Foreground" Value="#FFFFFFFF" />
        </Style>
      </ControlTheme>
      <ControlTheme x:Key="ComboBoxToggleButton2" TargetType="ToggleButton">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border
                Name="templateRoot"
                Background="{TemplateBinding Background}"
                BorderThickness="{TemplateBinding BorderThickness}"
                OpacityMask="#00000000"
                BorderBrush="{StaticResource ComboBox.Static.Border}"
              >
              <Border
                  Name="splitBorder"
                  Margin="0"
                  HorizontalAlignment="Stretch"
                  BorderThickness="0"
                  BorderBrush="#00FFFFFF"
                >
                <Path Name="arrow" VerticalAlignment="Center" IsVisible="False" Margin="0" HorizontalAlignment="Center" Data="F1 M0,0 L2.667,2.66665 L5.3334,0 L5.3334,-1.78168 L2.6667,0.88501 L0,-1.78168 L0,0" Fill="{StaticResource ComboBox.Static.Glyph}" />
              </Border>
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pressed /template/ Path#arrow">
          <Setter Property="Fill" Value="{StaticResource ComboBox.Pressed.Glyph}" />
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Foreground" Value="#FF7D7D7D" />
        </Style>
        <Style Selector="^:disabled /template/ Border#templateRoot">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:not(:disabled)">
          <Setter Property="Foreground" Value="#FFFFFFFF" />
        </Style>
      </ControlTheme>
