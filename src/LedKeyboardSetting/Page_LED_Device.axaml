      <LinearGradientBrush x:Key="ComboBox.Static.Background" EndPoint="0%,100%" StartPoint="0%,0%">
        <GradientStop Color="#FFF0F0F0" Offset="0.0" />
        <GradientStop Color="#FFE5E5E5" Offset="1.0" />
      </LinearGradientBrush>
      <SolidColorBrush x:Key="ComboBox.Static.Border" Color="#FFACACAC" />
      <SolidColorBrush x:Key="ScrollBar.Static.Background" Color="#F0F0F0" />
      <SolidColorBrush x:Key="ScrollBar.Static.Border" Color="#F0F0F0" />
      <SolidColorBrush x:Key="ScrollBar.Pressed.Glyph" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ScrollBar.MouseOver.Glyph" Color="#000000" />
      <SolidColorBrush x:Key="ScrollBar.Disabled.Glyph" Color="#BFBFBF" />
      <SolidColorBrush x:Key="ScrollBar.Static.Glyph" Color="#606060" />
      <SolidColorBrush x:Key="ScrollBar.Pressed.Background" Color="#606060" />
      <SolidColorBrush x:Key="ScrollBar.Pressed.Border" Color="#606060" />
      <ControlTheme x:Key="ScrollBarButton" TargetType="RepeatButton">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="1" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Name="border" Background="#66000000" BorderThickness="0">
              <ContentPresenter Name="contentPresenter" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Focusable="False" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#border">
          <Setter Property="Background" Value="#CC000000" />
        </Style>
        <Style Selector="^:pressed /template/ Border#border">
          <Setter Property="Background" Value="{StaticResource ScrollBar.Pressed.Background}" />
          <Setter Property="BorderBrush" Value="{StaticResource ScrollBar.Pressed.Border}" />
        </Style>
      </ControlTheme>
      <SolidColorBrush x:Key="ScrollBar.Pressed.Thumb" Color="#606060" />
      <ControlTheme x:Key="ScrollBarThumbVertical" TargetType="Thumb">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
          <ControlTemplate>
            <Rectangle Name="rectangle" Fill="{DynamicResource ScrollBar.Static.Thumb}" />
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Rectangle#rectangle">
          <Setter Property="Fill" Value="{DynamicResource ScrollBar.MouseOver.Thumb}" />
        </Style>
        <Style Selector="^:pressed /template/ Rectangle#rectangle">
          <Setter Property="Fill" Value="{DynamicResource ScrollBar.Pressed.Thumb}" />
        </Style>
      </ControlTheme>
      <SolidColorBrush x:Key="ScrollBar.MouseOver.Thumb" Color="#A6A6A6" />
      <SolidColorBrush x:Key="ScrollBar.Static.Thumb" Color="#CDCDCD" />
      <ControlTheme x:Key="ScrollBarThumbHorizontal" TargetType="Thumb">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
          <ControlTemplate>
            <Rectangle Name="rectangle" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" Fill="{StaticResource ScrollBar.Static.Thumb}" />
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Rectangle#rectangle">
          <Setter Property="Fill" Value="{StaticResource ScrollBar.MouseOver.Thumb}" />
        </Style>
      </ControlTheme>
      <ControlTheme x:Key="ScrollBarStyle1" TargetType="ScrollBar">
        <Setter Property="Background" Value="{DynamicResource ScrollBar.Static.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ScrollBar.Static.Border}" />
        <Setter Property="BorderThickness" Value="1,0" />
        <Setter Property="MinWidth" Value="17" />
        <Setter Property="Template">
          <ControlTemplate>
            <Grid Name="Bg" Width="10" HorizontalAlignment="Right">
              <Border Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" />
              <Track Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}" Value="{TemplateBinding Value, Mode=TwoWay}">
                <Track.DecreaseButton>
                  <RepeatButton Name="PART_PageUpButton" Theme="{StaticResource RepeatButtonTransparent}" />
                </Track.DecreaseButton>
                <Track.IncreaseButton>
                  <RepeatButton Name="PART_PageDownButton" Theme="{StaticResource RepeatButtonTransparent}" />
                </Track.IncreaseButton>
                <Thumb Theme="{StaticResource ScrollBarThumbVertical}" />
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter>
      </ControlTheme>
      <ControlTheme x:Key="ScrollViewerControlTemplate1" TargetType="ScrollViewer">
        <Setter Property="Template">
          <ControlTemplate>
            <Grid Name="Grid" Background="{TemplateBinding Background}" ColumnDefinitions="*,Auto" RowDefinitions="*,Auto">
              <ScrollContentPresenter Name="PART_ContentPresenter" Grid.Row="0" Grid.Column="0" Margin="{TemplateBinding Padding}"
                                      Extent="{Binding Extent, Mode=OneWayToSource, RelativeSource={RelativeSource TemplatedParent}}" Offset="{Binding Offset, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Viewport="{Binding Viewport, Mode=OneWayToSource, RelativeSource={RelativeSource TemplatedParent}}" />
              <ScrollBar Name="PART_VerticalScrollBar" Orientation="Vertical" Grid.Row="0" Grid.Column="1" Theme="{StaticResource ScrollBarStyle1}" Cursor="Arrow" AllowAutoHide="False" />
              <ScrollBar Name="PART_HorizontalScrollBar" Orientation="Horizontal" Grid.Row="1" Grid.Column="0" Cursor="Arrow" AllowAutoHide="False" />
            </Grid>
          </ControlTemplate>
        </Setter>
      </ControlTheme>
      <SolidColorBrush x:Key="ComboBox.Static.Editable.Background" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="ComboBox.Static.Editable.Border" Color="#FFABADB3" />
      <SolidColorBrush x:Key="ComboBox.Static.Editable.Button.Background" Color="Transparent" />
      <SolidColorBrush x:Key="ComboBox.Static.Editable.Button.Border" Color="Transparent" />
