<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:CC" x:Class="CC.Page_LED_Device" Name="userControl" Width="1920" Height="1080" BorderBrush="#FFFF0000" FontSize="12">
  <UserControl.Resources>
    <ResourceDictionary>
      <ControlTheme x:Key="WpfComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="4,1" />
        <Setter Property="HorizontalContentAlignment" Value="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
        <Setter Property="VerticalContentAlignment" Value="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Bd">
          <Setter Property="Background" Value="#1F26A0DA" />
        </Style>
        <Style Selector="^:selected /template/ Border#Bd">
          <Setter Property="Background" Value="#3D26A0DA" />
        </Style>
      </ControlTheme>
      <ControlTheme x:Key="WpfScrollBarH" TargetType="ScrollBar">
        <Setter Property="Background" Value="{DynamicResource ScrollBar.Static.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ScrollBar.Static.Border}" />
        <Setter Property="MinHeight" Value="17" />
        <Setter Property="Template">
          <ControlTemplate>
            <Grid Name="Bg" ColumnDefinitions="17,*,17" Background="{TemplateBinding Background}">
              <RepeatButton Name="PART_LineUpButton" Grid.Column="0" Background="{x:Null}" BorderBrush="{x:Null}" Focusable="False" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0">
                <Path Data="M4,0 L0,3.5 L4,7 Z" Margin="0" Stretch="Uniform" Height="7" Fill="{DynamicResource ScrollBar.Static.Glyph}" />
              </RepeatButton>
              <Track Name="PART_Track" Grid.Column="1" Orientation="Horizontal" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}" Value="{TemplateBinding Value, Mode=TwoWay}">
                <Track.DecreaseButton>
                  <RepeatButton Name="PART_PageUpButton" Theme="{StaticResource RepeatButtonTransparent}" />
                </Track.DecreaseButton>
                <Track.IncreaseButton>
                  <RepeatButton Name="PART_PageDownButton" Theme="{StaticResource RepeatButtonTransparent}" />
                </Track.IncreaseButton>
                <Thumb Theme="{StaticResource ScrollBarThumbVertical}" Margin="0,2" />
              </Track>
              <RepeatButton Name="PART_LineDownButton" Grid.Column="2" Background="{x:Null}" BorderBrush="{x:Null}" Focusable="False" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0">
                <Path Data="M0,0 L4,3.5 L0,7 Z" Margin="0" Stretch="Uniform" Height="7" Fill="{DynamicResource ScrollBar.Static.Glyph}" />
              </RepeatButton>
            </Grid>
          </ControlTemplate>
        </Setter>
      </ControlTheme>
      <SolidColorBrush x:Key="SliderThumb.Static.Foreground" Color="#FFE5E5E5" />
      <SolidColorBrush x:Key="SliderThumb.MouseOver.Background" Color="#FFDCECFC" />
      <SolidColorBrush x:Key="SliderThumb.MouseOver.Border" Color="#FF7Eb4EA" />
      <SolidColorBrush x:Key="SliderThumb.Pressed.Background" Color="#FFDAECFC" />
      <SolidColorBrush x:Key="SliderThumb.Pressed.Border" Color="#FF569DE5" />
      <SolidColorBrush x:Key="SliderThumb.Disabled.Background" Color="#FFF0F0F0" />
      <SolidColorBrush x:Key="SliderThumb.Disabled.Border" Color="#FFD9D9D9" />
      <SolidColorBrush x:Key="SliderThumb.Static.Background" Color="#FFF0F0F0" />
      <SolidColorBrush x:Key="SliderThumb.Static.Border" Color="#FFACACAC" />
      <ControlTheme x:Key="SliderThumbHorizontalTop" TargetType="Thumb">
        <Setter Property="Template">
          <ControlTemplate>
            <Grid HorizontalAlignment="Center" UseLayoutRounding="True" VerticalAlignment="Center">
              <Path Name="grip" Data="M0,6 C0,6 5.5,0 5.5,0 C5.5,0 11,6 11,6 C11,6 11,18 11,18 C11,18 0,18 0,18 C0,18 0,6 0,6" Stretch="Fill" StrokeThickness="1" UseLayoutRounding="True" VerticalAlignment="Center" Fill="{StaticResource SliderThumb.Static.Background}" Stroke="{StaticResource SliderThumb.Static.Border}" />
            </Grid>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Path#grip">
          <Setter Property="Fill" Value="{StaticResource SliderThumb.MouseOver.Background}" />
          <Setter Property="Stroke" Value="{StaticResource SliderThumb.MouseOver.Border}" />
        </Style>
        <Style Selector="^:disabled /template/ Path#grip">
          <Setter Property="Fill" Value="{StaticResource SliderThumb.Disabled.Background}" />
          <Setter Property="Stroke" Value="{StaticResource SliderThumb.Disabled.Border}" />
        </Style>
      </ControlTheme>
      <ControlTheme x:Key="SliderThumbHorizontalBottom" TargetType="Thumb">
        <Setter Property="Template">
          <ControlTemplate>
            <Grid HorizontalAlignment="Center" UseLayoutRounding="True" VerticalAlignment="Center">
              <Path Name="grip" Data="M0,12 C0,12 5.5,18 5.5,18 C5.5,18 11,12 11,12 C11,12 11,0 11,0 C11,0 0,0 0,0 C0,0 0,12 0,12" Stretch="Fill" StrokeThickness="1" UseLayoutRounding="True" VerticalAlignment="Center" Fill="{StaticResource SliderThumb.Static.Background}" Stroke="{StaticResource SliderThumb.Static.Border}" />
            </Grid>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Path#grip">
          <Setter Property="Fill" Value="{StaticResource SliderThumb.MouseOver.Background}" />
          <Setter Property="Stroke" Value="{StaticResource SliderThumb.MouseOver.Border}" />
        </Style>
        <Style Selector="^:disabled /template/ Path#grip">
          <Setter Property="Fill" Value="{StaticResource SliderThumb.Disabled.Background}" />
          <Setter Property="Stroke" Value="{StaticResource SliderThumb.Disabled.Border}" />
        </Style>
      </ControlTheme>
      <SolidColorBrush x:Key="SliderThumb.Track.Border" Color="#FFD6D6D6" />
      <SolidColorBrush x:Key="SliderThumb.Track.Background" Color="#FFE7EAEA" />
      <ControlTheme x:Key="RepeatButtonTransparent" TargetType="RepeatButton">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
          <ControlTemplate>
            <Rectangle Fill="{TemplateBinding Background}" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}" />
          </ControlTemplate>
        </Setter>
      </ControlTheme>
      <ControlTheme x:Key="SliderThumbHorizontalDefault" TargetType="Thumb">
        <Setter Property="Template">
          <ControlTemplate>
            <Grid HorizontalAlignment="Center" UseLayoutRounding="True" VerticalAlignment="Center">
              <Rectangle
                  Name="rectangle"
                  HorizontalAlignment="Stretch"
                  Height="60"
                  Margin="-20.487,-9.966,-19.514,-10.035"
                  StrokeThickness="2"
                  VerticalAlignment="Stretch"
                  Width="48"
                  Fill="{TemplateBinding BorderBrush}"
                  RenderTransformOrigin="50%,50%"
                  UseLayoutRounding="False"
                  IsVisible="False"
                >
                <Rectangle.RenderTransform>
                  <TransformGroup>
                    <SkewTransform AngleX="32" />
                  </TransformGroup>
                </Rectangle.RenderTransform>
                <Rectangle.OpacityMask>
                  <ImageBrush Source="/Image/Page_SystemMonitor/CPUGPUSetting/slider_handle_layer1.png" />
                </Rectangle.OpacityMask>
              </Rectangle>
              <Path
                  Name="grip"
                  Data="M0,0 C0,0 11,0 11,0 C11,0 11,18 11,18 C11,18 0,18 0,18 C0,18 0,0 0,0"
                  Stretch="Fill"
                  StrokeThickness="2"
                  UseLayoutRounding="True"
                  VerticalAlignment="Center"
                >
                <Path.Fill>
                  <LinearGradientBrush EndPoint="50%,100%" StartPoint="50%,0%">
                    <GradientStop Color="#FF606060" Offset="0.046" />
                    <GradientStop Color="White" Offset="0.503" />
                    <GradientStop Color="#FF606060" Offset="0.943" />
                  </LinearGradientBrush>
                </Path.Fill>
              </Path>
            </Grid>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Rectangle#rectangle">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:disabled /template/ Path#grip">
          <Setter Property="Fill" Value="{StaticResource SliderThumb.Disabled.Background}" />
          <Setter Property="Stroke" Value="{StaticResource SliderThumb.Disabled.Border}" />
        </Style>
      </ControlTheme>
      <!-- MANUAL: SliderHorizontal -->
      <ControlTheme x:Key="SliderThumbVerticalRight" TargetType="Thumb">
        <Setter Property="Template">
          <ControlTemplate>
            <Grid HorizontalAlignment="Center" UseLayoutRounding="True" VerticalAlignment="Center">
              <Path Name="grip" Data="M12,11 C12,11 18,5.5 18,5.5 C18,5.5 12,0 12,0 C12,0 0,0 0,0 C0,0 0,11 0,11 C0,11 12,11 12,11" Stretch="Fill" Fill="{StaticResource SliderThumb.Static.Background}" Stroke="{StaticResource SliderThumb.Static.Border}" />
            </Grid>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Path#grip">
          <Setter Property="Fill" Value="{StaticResource SliderThumb.MouseOver.Background}" />
          <Setter Property="Stroke" Value="{StaticResource SliderThumb.MouseOver.Border}" />
        </Style>
        <Style Selector="^:disabled /template/ Path#grip">
          <Setter Property="Fill" Value="{StaticResource SliderThumb.Disabled.Background}" />
          <Setter Property="Stroke" Value="{StaticResource SliderThumb.Disabled.Border}" />
        </Style>
      </ControlTheme>
      <ControlTheme x:Key="SliderThumbVerticalDefault" TargetType="Thumb">
        <Setter Property="Template">
          <ControlTemplate>
            <Grid HorizontalAlignment="Center" UseLayoutRounding="True" VerticalAlignment="Center" Width="90" Height="90">
              <Path Name="grip" Data="M0.5,0.5 L18.5,0.5 L18.5,11.5 L0.5,11.5" Fill="{TemplateBinding BorderBrush}" Stretch="Fill" Stroke="{DynamicResource SliderThumb.Static.Border}">
                <Path.OpacityMask>
                  <ImageBrush Source="/image/page_leddevice/kb_brightness/ic_kb_brightness_layer2_selected.png" />
                </Path.OpacityMask>
              </Path>
              <Rectangle Fill="#FFFFFFFF" Stroke="{DynamicResource SliderThumb.Static.Border}">
                <Rectangle.OpacityMask>
                  <ImageBrush Source="/image/page_leddevice/kb_brightness/thumb_layer2.png" />
                </Rectangle.OpacityMask>
              </Rectangle>
            </Grid>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Path#grip">
          <Setter Property="Stroke" Value="{DynamicResource SliderThumb.MouseOver.Border}" />
        </Style>
        <Style Selector="^:pressed /template/ Path#grip">
          <Setter Property="Stroke" Value="{DynamicResource SliderThumb.Pressed.Border}" />
        </Style>
        <Style Selector="^:disabled /template/ Path#grip">
          <Setter Property="Fill" Value="{DynamicResource SliderThumb.Disabled.Background}" />
          <Setter Property="Stroke" Value="{DynamicResource SliderThumb.Disabled.Border}" />
        </Style>
      </ControlTheme>
      <!-- MANUAL: SliderVertical -->
      <ControlTheme x:Key="RepeatButtonStyle_L" TargetType="RepeatButton">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
          <ControlTemplate>
            <Grid
                HorizontalAlignment="Stretch"
                Margin="0"
                VerticalAlignment="Stretch"
                ClipToBounds="True"
              >
              <Rectangle
                  Fill="{TemplateBinding BorderBrush}"
                  HorizontalAlignment="Left"
                  Height="25"
                  VerticalAlignment="Top"
                  Width="355"
                  Margin="6.025,16.033,-183.408,0"
                >
                <Rectangle.OpacityMask>
                  <ImageBrush Source="/Image/Page_SystemMonitor/CPUGPUSetting/slider_range_2.png" Stretch="Fill" />
                </Rectangle.OpacityMask>
              </Rectangle>
            </Grid>
          </ControlTemplate>
        </Setter>
      </ControlTheme>
      <SolidColorBrush x:Key="RadioButton.Static.Background" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="RadioButton.Static.Border" Color="#FF707070" />
      <ControlTheme x:Key="RadioButtonStyle1_ONOFF" TargetType="RadioButton">
        <Setter Property="Background" Value="{StaticResource RadioButton.Static.Background}" />
        <Setter Property="BorderBrush" Value="{StaticResource RadioButton.Static.Border}" />
        <Setter Property="Foreground" Value="#FF000000" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
          <ControlTemplate>
            <Grid Name="templateRoot" Background="#00FFFFFF">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid
                  Height="46"
                  Margin="0"
                  VerticalAlignment="Center"
                  Width="46"
                >
                <Rectangle
                    Name="rectangle"
                    Margin="0"
                    Width="46"
                    Height="46"
                    StrokeThickness="0"
                    Fill="{TemplateBinding Background}"
                    Stroke="{x:Null}"
                  >
                  <Rectangle.OpacityMask>
                    <ImageBrush Source="/image/page_systemmonitor/fan/btn_enable.png" />
                  </Rectangle.OpacityMask>
                </Rectangle>
              </Grid>
              <Border Name="radioButtonBorder" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="100" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="1,1,2,1" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" IsVisible="False" />
              <TextBlock Name="textBlock" Grid.Column="1" Margin="0" TextWrapping="Wrap" Text="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="#FFB4B4B4" FontSize="21.333" />
            </Grid>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:checked /template/ Rectangle#rectangle">
          <Setter Property="OpacityMask">
            <ImageBrush Source="/image/page_systemmonitor/fan/btn_disable.png" />
          </Setter>
        </Style>
        <Style Selector="^:checked /template/ TextBlock#textBlock">
          <Setter Property="Foreground" Value="#FFFFFFFF" />
          <Setter Property="FontSize" Value="24" />
        </Style>
      </ControlTheme>
      <ControlTheme x:Key="RadioButtonStyle1_FAN" TargetType="RadioButton">
        <Setter Property="Background" Value="{StaticResource RadioButton.Static.Background}" />
        <Setter Property="BorderBrush" Value="{StaticResource RadioButton.Static.Border}" />
        <Setter Property="Foreground" Value="#FF000000" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
          <ControlTemplate>
            <Grid Name="templateRoot" Background="#00FFFFFF">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid
                  Height="46"
                  Margin="0"
                  VerticalAlignment="Center"
                  Width="46"
                >
                <Rectangle
                    Name="rectangle"
                    Margin="0"
                    Width="46"
                    Height="46"
                    StrokeThickness="0"
                    Fill="{TemplateBinding Background}"
                    Stroke="{x:Null}"
                  >
                  <Rectangle.OpacityMask>
                    <ImageBrush Source="/image/page_systemmonitor/fan/btn_enable.png" />
                  </Rectangle.OpacityMask>
                </Rectangle>
              </Grid>
              <Border Name="radioButtonBorder" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="100" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="1,1,2,1" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" IsVisible="False" />
              <TextBlock Name="textBlock" Grid.Column="1" Margin="0" TextWrapping="Wrap" Text="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="#FFB4B4B4" FontSize="21.333" />
            </Grid>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:checked /template/ Rectangle#rectangle">
          <Setter Property="OpacityMask">
            <ImageBrush Source="/image/page_systemmonitor/fan/btn_disable.png" />
          </Setter>
        </Style>
        <Style Selector="^:checked /template/ TextBlock#textBlock">
          <Setter Property="Foreground" Value="#FFFFFFFF" />
          <Setter Property="FontSize" Value="24" />
        </Style>
      </ControlTheme>
      <SolidColorBrush x:Key="Button.Static.Background" Color="#FFDDDDDD" />
      <SolidColorBrush x:Key="Button.Static.Border" Color="#FF707070" />
      <ControlTheme x:Key="RadioButtonStyle_Perkey_Wave" TargetType="RadioButton">
        <Setter Property="Background" Value="{StaticResource RadioButton.Static.Background}" />
        <Setter Property="BorderBrush" Value="{StaticResource RadioButton.Static.Border}" />
        <Setter Property="Foreground" Value="#FF000000" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
          <ControlTemplate>
            <Grid Name="templateRoot" Background="#00FFFFFF">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="87" />
              </Grid.ColumnDefinitions>
              <Rectangle
                  Name="rectangle"
                  Fill="{TemplateBinding BorderBrush}"
                  Height="25"
                  Margin="0"
                  Stroke="#FF000000"
                  VerticalAlignment="Bottom"
                  Width="70"
                  HorizontalAlignment="Left"
                  IsVisible="False"
                >
                <Rectangle.OpacityMask>
                  <ImageBrush Source="/image/page_leddevice/led_mode_effect/bar_led_effect_selected_layer1.png" />
                </Rectangle.OpacityMask>
              </Rectangle>
              <Image Name="Image_Page_LEDdevice_LED_Mode_Effect_bar_led_effect_selected_layer2_png" Height="25" Source="/image/page_leddevice/led_mode_effect/bar_led_effect_selected_layer2.png" Stretch="Fill" Width="70" IsVisible="False" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="0" />
              <Rectangle
                  Name="rectangle_2"
                  Fill="{TemplateBinding BorderBrush}"
                  Height="62"
                  Margin="5,0,0,0"
                  VerticalAlignment="Top"
                  Width="62"
                  HorizontalAlignment="Left"
                  IsVisible="False"
                  Stroke="{x:Null}"
                >
                <Rectangle.OpacityMask>
                  <ImageBrush Source="/image/page_leddevice/led_mode_effect/btn_led_effect_wave_layer1_hover.png" />
                </Rectangle.OpacityMask>
              </Rectangle>
              <Rectangle
                  Name="rectangle_3"
                  Height="62"
                  Margin="5,0,0,0"
                  VerticalAlignment="Top"
                  Width="62"
                  HorizontalAlignment="Left"
                  Fill="#FF535353"
                  Stroke="{x:Null}"
                >
                <Rectangle.OpacityMask>
                  <ImageBrush Source="/image/page_leddevice/led_mode_effect/btn_led_effect_wave_selected.png" />
                </Rectangle.OpacityMask>
              </Rectangle>
            </Grid>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Rectangle#rectangle_2">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:checked /template/ Rectangle#rectangle_3">
          <Setter Property="Fill" Value="#FFFFFFFF" />
        </Style>
        <Style Selector="^:checked /template/ Rectangle#rectangle">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:checked /template/ Image#Image_Page_LEDdevice_LED_Mode_Effect_bar_led_effect_selected_layer2_png">
          <Setter Property="IsVisible" Value="True" />
        </Style>
      </ControlTheme>
      <SolidColorBrush x:Key="OptionMark.Static.Background" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="OptionMark.Static.Border" Color="#FF707070" />
      <ControlTheme x:Key="CheckBoxStyle_ledkey" TargetType="CheckBox">
        <Setter Property="Background" Value="{StaticResource OptionMark.Static.Background}" />
        <Setter Property="BorderBrush" Value="{StaticResource OptionMark.Static.Border}" />
        <Setter Property="Foreground" Value="#FF000000" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
          <ControlTemplate>
            <Grid Name="templateRoot" Background="#00FFFFFF">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Path Name="p_enter" Grid.ColumnSpan="2" Data="M0.97300005,2.443 L1.1730001,61.743005 L18.973,61.743002 L19.173,133.643 L72.873001,133.74301 L73.673001,2.6430001" Margin="0.973,2.443,0.604,2.003" Stretch="Fill" StrokeThickness="0" VerticalAlignment="Stretch" Fill="{TemplateBinding BorderBrush}" IsVisible="False" Opacity="0.5" />
              <Path
                  Name="p_enter_disble"
                  Grid.ColumnSpan="2"
                  Data="M0.97300005,2.443 L1.1730001,61.743005 L18.973,61.743002 L19.173,133.643 L72.873001,133.74301 L73.673001,2.6430001"
                  Margin="0.973,2.443,0.604,2.003"
                  Stretch="Fill"
                  StrokeThickness="0"
                  VerticalAlignment="Stretch"
                  IsVisible="False"
                >
                <Path.OpacityMask>
                  <LinearGradientBrush EndPoint="50%,100%" StartPoint="50%,0%">
                    <GradientStop Color="White" />
                    <GradientStop Color="#E5000000" Offset="0.58" />
                  </LinearGradientBrush>
                </Path.OpacityMask>
                <Path.Fill>
                  <LinearGradientBrush EndPoint="50%,100%" StartPoint="50%,0%">
                    <GradientStop Color="Black" />
                    <GradientStop Color="#FF171717" Offset="1" />
                  </LinearGradientBrush>
                </Path.Fill>
              </Path>
              <Rectangle Name="rectangle" Grid.ColumnSpan="2" Fill="{TemplateBinding BorderBrush}" Margin="2" StrokeThickness="0" Opacity="0.5" OpacityMask="{x:Null}" />
              <Rectangle
                  Name="rectangle_disable"
                  Grid.ColumnSpan="2"
                  Margin="2"
                  StrokeThickness="0"
                  IsVisible="False"
                >
                <Rectangle.Fill>
                  <LinearGradientBrush EndPoint="50%,100%" StartPoint="50%,0%">
                    <GradientStop Color="Black" />
                    <GradientStop Color="#FF171717" Offset="1" />
                  </LinearGradientBrush>
                </Rectangle.Fill>
                <Rectangle.OpacityMask>
                  <LinearGradientBrush EndPoint="50%,100%" StartPoint="50%,0%">
                    <GradientStop Color="White" />
                    <GradientStop Color="#E5000000" Offset="0.58" />
                  </LinearGradientBrush>
                </Rectangle.OpacityMask>
              </Rectangle>
              <TextBlock Name="textBlock" Grid.ColumnSpan="2" Margin="0" TextWrapping="Wrap" Text="{TemplateBinding Tag}" Foreground="#FFFFFFFF" FontSize="{TemplateBinding FontSize}" FontFamily="Microsoft Sans Serif" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Path Name="path2" Grid.ColumnSpan="1" Data="M0.50033333,2.2533333 L0.50033333,63.853333" Fill="#FF515151" Height="135.746" Margin="0" Stretch="Fill" StrokeThickness="3" VerticalAlignment="Top" Width="3" HorizontalAlignment="Left" Stroke="#FF515151" />
              <Path Name="path1" Grid.ColumnSpan="2" Data="M0.50033333,2.2533333 L0.50033333,63.853333" Fill="#FF515151" Margin="0" Stretch="Fill" StrokeThickness="3" VerticalAlignment="Bottom" Width="3" HorizontalAlignment="Right" Stroke="#FF515151" />
              <Path Name="path3" Grid.ColumnSpan="2" Data="M-0.1767072,46.199998 L59.300776,46.200334" Height="6" Margin="-3,0,-3,0.086" Stretch="Fill" Stroke="#FF515151" StrokeThickness="6" VerticalAlignment="Bottom" Fill="{x:Null}" />
              <Path Name="path" Grid.ColumnSpan="2" Data="M0.51153622,2.0339867 C28.044688,-0.4261159 56.911536,2.0339867 56.911536,2.0339867" Height="4.089" Margin="-0.325,0.447,0.335,0" Stretch="Fill" Stroke="#FF515151" StrokeThickness="3" VerticalAlignment="Top" Fill="{x:Null}" />
              <Path Name="path4" Grid.ColumnSpan="1" Data="M-3.3718116,61.525553 C17.694855,61.658887 26.960643,61.65937 26.960643,61.65937 C27.093972,64.329001 27.005086,110.20216 27.027308,134.47356" Margin="-2,60.526,68.354,-0.647" Stretch="Fill" Stroke="#FF515151" StrokeThickness="3" Grid.Column="1" IsVisible="False" Fill="{x:Null}" />
              <Image
                  Name="KB_icon"
                  Grid.ColumnSpan="2"
                  HorizontalAlignment="Center"
                  Height="60"
                  Margin="0"
                  VerticalAlignment="Center"
                  Width="60"
                  RenderTransformOrigin="50%,50%"
                >
                <Image.RenderTransform>
                  <TransformGroup />
                </Image.RenderTransform>
              </Image>
            </Grid>
          </ControlTemplate>
        </Setter>
        <Style Selector="^[Content=6e][Tag=UK] /template/ TextBlock#textBlock">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^[Content=6e][Tag=UK] /template/ Image#KB_icon">
          <Setter Property="Source" Value="/image/page_leddevice/key/key_6d.png" />
        </Style>
        <Style Selector="^[Content=6e][Tag=JB] /template/ TextBlock#textBlock">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^[Content=6e][Tag=JB] /template/ Image#KB_icon">
          <Setter Property="Source" Value="/image/page_leddevice/key/key_4d.png" />
        </Style>
        <Style Selector="^[Content=6e][Tag=BR] /template/ TextBlock#textBlock">
