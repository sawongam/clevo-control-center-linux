      <ControlTheme x:Key="ScrollBarStyle1_cpuset" TargetType="ScrollBar">
        <Setter Property="Background" Value="{DynamicResource ScrollBar.Static.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ScrollBar.Static.Border}" />
        <Setter Property="BorderThickness" Value="1,0" />
        <Setter Property="MinWidth" Value="17" />
        <Setter Property="Template">
          <ControlTemplate>
            <Grid Name="Bg" RowDefinitions="17,*,17">
              <Border Grid.Row="1" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" />
              <RepeatButton Name="PART_LineUpButton" Grid.Row="0" Background="{x:Null}" BorderBrush="{x:Null}" Focusable="False">
                <Path Data="M0,4 C0,4 0,6 0,6 C0,6 3.5,2.5 3.5,2.5 C3.5,2.5 7,6 7,6 C7,6 7,4 7,4 C7,4 3.5,0.5 3.5,0.5 C3.5,0.5 0,4 0,4" Margin="3,4,3,3" Stretch="Uniform" Fill="{DynamicResource ScrollBar.Static.Glyph}" />
              </RepeatButton>
              <RepeatButton Name="PART_LineDownButton" Grid.Row="2" Background="{x:Null}" BorderBrush="{x:Null}" Focusable="False">
                <Path Data="M0,2.5 C0,2.5 0,0.5 0,0.5 C0,0.5 3.5,4 3.5,4 C3.5,4 7,0.5 7,0.5 C7,0.5 7,2.5 7,2.5 C7,2.5 3.5,6 3.5,6 C3.5,6 0,2.5 0,2.5" Margin="3,4,3,3" Stretch="Uniform" Fill="{DynamicResource ScrollBar.Static.Glyph}" />
              </RepeatButton>
              <Track Name="PART_Track" Grid.Row="1" IsDirectionReversed="True" Orientation="Vertical" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}" Value="{TemplateBinding Value, Mode=TwoWay}">
                <Track.DecreaseButton>
                  <RepeatButton Name="PART_PageUpButton" Theme="{StaticResource RepeatButtonTransparent}" />
                </Track.DecreaseButton>
                <Track.IncreaseButton>
                  <RepeatButton Name="PART_PageDownButton" Theme="{StaticResource RepeatButtonTransparent}" />
                </Track.IncreaseButton>
                <Thumb Theme="{StaticResource ScrollBarThumbVertical}" />
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter>
      </ControlTheme>
      <ControlTheme x:Key="ScrollViewerControlTemplate1_cpuset" TargetType="ScrollViewer">
        <Setter Property="Template">
          <ControlTemplate>
            <Grid Name="Grid" Background="{TemplateBinding Background}" ColumnDefinitions="*,Auto" RowDefinitions="*,Auto">
              <ScrollContentPresenter Name="PART_ContentPresenter" Grid.Row="0" Grid.Column="0" Margin="{TemplateBinding Padding}"
                                      Extent="{Binding Extent, Mode=OneWayToSource, RelativeSource={RelativeSource TemplatedParent}}" Offset="{Binding Offset, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Viewport="{Binding Viewport, Mode=OneWayToSource, RelativeSource={RelativeSource TemplatedParent}}" />
              <ScrollBar Name="PART_VerticalScrollBar" Orientation="Vertical" Grid.Row="0" Grid.Column="1" Theme="{StaticResource ScrollBarStyle1_cpuset}" Cursor="Arrow" AllowAutoHide="False" />
              <ScrollBar Name="PART_HorizontalScrollBar" Orientation="Horizontal" Grid.Row="1" Grid.Column="0" Theme="{StaticResource WpfScrollBarH}" Cursor="Arrow" AllowAutoHide="False" />
            </Grid>
          </ControlTemplate>
        </Setter>
      </ControlTheme>
      <ControlTheme x:Key="CheckBoxStyle_auto" TargetType="CheckBox">
        <Setter Property="Background" Value="{StaticResource OptionMark.Static.Background}" />
        <Setter Property="BorderBrush" Value="{StaticResource OptionMark.Static.Border}" />
        <Setter Property="Foreground" Value="#FF000000" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
          <ControlTemplate>
            <Grid Name="templateRoot" Background="#00FFFFFF">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid
                  Height="46"
                  Margin="0"
                  VerticalAlignment="Center"
                  Width="46"
                >
                <Rectangle
                    Name="rectangle"
                    Margin="0"
                    Width="46"
                    Height="46"
                    StrokeThickness="0"
                    Fill="{TemplateBinding Background}"
                    Stroke="{x:Null}"
                  >
                  <Rectangle.OpacityMask>
                    <ImageBrush Source="/image/page_systemmonitor/fan/btn_enable.png" />
                  </Rectangle.OpacityMask>
                </Rectangle>
              </Grid>
              <Border Name="radioButtonBorder" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="100" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="1,22,0,0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" IsVisible="False" />
              <TextBlock Name="textBlock" Grid.Column="1" Margin="0" TextWrapping="Wrap" Text="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="#FFB4B4B4" FontSize="21.333" />
            </Grid>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="0.3" />
        </Style>
        <Style Selector="^:checked /template/ Rectangle#rectangle">
          <Setter Property="OpacityMask">
            <ImageBrush Source="/image/page_systemmonitor/fan/btn_disable.png" />
          </Setter>
        </Style>
        <Style Selector="^:checked /template/ TextBlock#textBlock">
          <Setter Property="Foreground" Value="#FFFFFFFF" />
          <Setter Property="FontSize" Value="24" />
        </Style>
      </ControlTheme>
      <ControlTheme x:Key="ButtonStyle1_WholeColor" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Button.Static.Background}" />
        <Setter Property="BorderBrush" Value="{StaticResource Button.Static.Border}" />
        <Setter Property="Foreground" Value="#FF000000" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="1" />
        <Setter Property="Template">
          <ControlTemplate>
            <Grid Name="templateRoot" Margin="0" Background="{x:Null}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ContentPresenter Name="contentPresenter" Grid.Column="1" Focusable="False" HorizontalAlignment="Stretch" Margin="100.876,0,108.876,43.18" VerticalAlignment="Bottom" IsVisible="True" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
              <Path Grid.ColumnSpan="2" Data="M122.3915,81.567496 C100.02397,81.567497 81.891502,99.699965 81.891502,122.0675 C81.891502,144.43503 100.02397,162.5675 122.3915,162.5675 C144.75903,162.5675 162.8915,144.43503 162.8915,122.0675 C162.8915,99.699965 144.75903,81.567497 122.3915,81.567496 M121.5,0 C188.6026,0 243.00001,54.3974 243.00001,121.5 C243.00001,188.60259 188.6026,242.99999 121.5,242.99999 C54.397406,242.99999 0,188.60259 0,121.5 C0,54.3974 54.397406,0 121.5,0" Margin="15.267,12.8,13.733,14.2" Stretch="Fill" Fill="#02B30000" />
            </Grid>
          </ControlTemplate>
        </Setter>
      </ControlTheme>
      <ControlTheme x:Key="RectangleStyle1_colorR" TargetType="Rectangle">
        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="0.2" />
        </Style>
        <Style Selector="^:not(:disabled)">
          <Setter Property="Opacity" Value="1" />
        </Style>
      </ControlTheme>
      <ControlTheme x:Key="SliderStyle2" TargetType="Slider">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderBrush" Value="#00FFFFFF" />
        <Setter Property="Foreground" Value="{DynamicResource SliderThumb.Static.Foreground}" />
        <!-- WPF SliderVertical template (Avalonia part names: PART_Track / PART_DecreaseButton / PART_IncreaseButton) -->
        <Setter Property="Template">
          <ControlTemplate>
            <Border Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition MinWidth="{TemplateBinding MinWidth}" Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TickBar Name="TopTick" Grid.Column="0" Fill="{TemplateBinding Foreground}" Margin="0,0,2,0" Placement="Left" Width="4" IsVisible="False" Ticks="{TemplateBinding Ticks}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" TickFrequency="{TemplateBinding TickFrequency}" />
                <TickBar Name="BottomTick" Grid.Column="2" Fill="{TemplateBinding Foreground}" Margin="2,0,0,0" Placement="Right" Width="4" IsVisible="False" Ticks="{TemplateBinding Ticks}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" TickFrequency="{TemplateBinding TickFrequency}" />
                <Border Name="TrackBackground" BorderThickness="1" Grid.Column="1" HorizontalAlignment="Center" Margin="0,44" Width="4.0" BorderBrush="{DynamicResource SliderThumb.Track.Border}" Background="{DynamicResource SliderThumb.Track.Background}" />
                <Track Name="PART_Track" Grid.Column="1" Orientation="Vertical" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value, Mode=TwoWay}">
                  <Track.DecreaseButton>
                    <RepeatButton Name="PART_DecreaseButton" Theme="{StaticResource RepeatButtonTransparent}" />
                  </Track.DecreaseButton>
                  <Track.IncreaseButton>
                    <RepeatButton Name="PART_IncreaseButton" Theme="{StaticResource RepeatButtonTransparent}" />
                  </Track.IncreaseButton>
                  <Thumb Name="Thumb" Focusable="False" VerticalAlignment="Top" BorderBrush="{TemplateBinding BorderBrush}" Theme="{StaticResource SliderThumbVerticalDefault}" />
                </Track>
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^[TickPlacement=TopLeft] /template/ TickBar#TopTick">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^[TickPlacement=TopLeft] /template/ Border#TrackBackground">
          <Setter Property="Margin" Value="2,44,0,44" />
        </Style>
        <Style Selector="^[TickPlacement=BottomRight] /template/ TickBar#BottomTick">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^[TickPlacement=BottomRight] /template/ Border#TrackBackground">
          <Setter Property="Margin" Value="0,5,2,5" />
        </Style>
      </ControlTheme>
      <ControlTheme x:Key="RadioButton_EffectArrow1" TargetType="RadioButton">
        <Setter Property="Background" Value="{StaticResource RadioButton.Static.Background}" />
        <Setter Property="BorderBrush" Value="{StaticResource RadioButton.Static.Border}" />
        <Setter Property="Foreground" Value="#FF000000" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
          <ControlTemplate>
            <Grid Name="templateRoot" Background="#00FFFFFF">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="87" />
              </Grid.ColumnDefinitions>
              <Rectangle
                  Name="rectangle_3"
                  Height="62"
                  Margin="5,0,0,0"
                  VerticalAlignment="Top"
                  Width="62"
                  HorizontalAlignment="Left"
                  Fill="#FF535353"
                  Stroke="{x:Null}"
                >
                <Rectangle.OpacityMask>
                  <ImageBrush Source="/image/page_leddevice/led_mode_effect/effectarrow_45.png" />
                </Rectangle.OpacityMask>
              </Rectangle>
              <Rectangle
                  Name="rectangle_MouseOver"
                  Height="62"
                  Margin="5,0,0,0"
                  VerticalAlignment="Top"
                  Width="62"
                  HorizontalAlignment="Left"
                  Fill="{TemplateBinding BorderBrush}"
                  IsVisible="False"
                  Stroke="{x:Null}"
                >
                <Rectangle.OpacityMask>
                  <ImageBrush Source="/image/page_leddevice/led_mode_effect/effectarrow_45.png" />
                </Rectangle.OpacityMask>
              </Rectangle>
            </Grid>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Rectangle#rectangle_3">
          <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:pointerover /template/ Rectangle#rectangle_MouseOver">
          <Setter Property="IsVisible" Value="True" />
