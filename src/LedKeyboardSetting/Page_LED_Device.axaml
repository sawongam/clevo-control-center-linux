  <Grid Name="main" Background="#02000000">
    <Image Name="image_Copy" HorizontalAlignment="Left" Margin="0" Width="1913" Source="/image/page_extrasetting/bg_extra_setting_layer_3.png" VerticalAlignment="Bottom" Height="1046" Opacity="0.1" IsVisible="False" />
    <Grid
        Name="grid_LED_Mode"
        HorizontalAlignment="Left"
        Margin="30,213.6,0,30"
        Width="256.4"
      >
      <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top">
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Orientation="Horizontal"
            Margin="0"
          >
          <Image Name="image" HorizontalAlignment="Left" Height="46" VerticalAlignment="Center" Width="46" Source="/image/page_leddevice/led_mode_effect/ic_led_mode.png" />
          <TextBlock Name="T_LedMode" Margin="0" TextWrapping="Wrap" Text="LED Mode" VerticalAlignment="Center" FontFamily="Microsoft Sans Serif" FontSize="22" Foreground="#FFFFFFFF" HorizontalAlignment="Left" />
        </StackPanel>
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Orientation="Horizontal"
            Margin="0"
          >
          <Path Name="PathLedModeLeftTop" Data="M27.432996,1.9338688 L2.7653421,1.9338688 L2.7663342,104.36994" HorizontalAlignment="Left" Height="14.733" Stretch="Fill" StrokeThickness="3" VerticalAlignment="Center" Width="60.066" Stroke="{Binding #userControl.BorderBrush}" />
          <Path Name="PathLedModeMidTop" Data="M24.5,0 L382,0" Height="2" Margin="0" Stretch="Fill" VerticalAlignment="Top" StrokeThickness="2" StrokeDashArray="1.5,1.5" HorizontalAlignment="Left" Width="119" Stroke="{Binding #PathLedModeLeftTop.Stroke}" />
          <Path
              Name="PathLedModeRightTop"
              Data="M27.432996,1.9338688 L2.7653421,1.9338688 L2.7663342,104.36994"
              Height="14.733"
              Margin="0"
              Stretch="Fill"
              StrokeThickness="3"
              VerticalAlignment="Center"
              RenderTransformOrigin="50%,50%"
              HorizontalAlignment="Left"
              Width="60.066"
              Stroke="{Binding #userControl.BorderBrush}"
            >
            <Path.RenderTransform>
              <TransformGroup>
                <ScaleTransform ScaleY="1" ScaleX="-1" />
              </TransformGroup>
            </Path.RenderTransform>
          </Path>
        </StackPanel>
        <ScrollViewer
            Name="SV_LED_Mode"
            Theme="{DynamicResource ScrollViewerControlTemplate1_cpuset}"
            Height="330"
            Width="231.8"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            VerticalScrollBarVisibility="Auto"
            Focusable="False"
          >
          <StackPanel
              Name="SP_LED_Mode"
              HorizontalAlignment="Left"
              VerticalAlignment="Top"
              Width="207.013"
            >
