<ControlTheme x:Key="SliderStyle2" TargetType="Slider">
  <Setter Property="Background" Value="#00FFFFFF" />
  <Setter Property="BorderBrush" Value="#00FFFFFF" />
  <Setter Property="Foreground" Value="{DynamicResource SliderThumb.Static.Foreground}" />
  <!-- WPF SliderVertical template (Avalonia part names: PART_Track / PART_DecreaseButton / PART_IncreaseButton) -->
  <Setter Property="Template">
    <ControlTemplate>
      <Border Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition MinWidth="{TemplateBinding MinWidth}" Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TickBar Name="TopTick" Grid.Column="0" Fill="{TemplateBinding Foreground}" Margin="0,0,2,0" Placement="Left" Width="4" IsVisible="False" Ticks="{TemplateBinding Ticks}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" TickFrequency="{TemplateBinding TickFrequency}" />
          <TickBar Name="BottomTick" Grid.Column="2" Fill="{TemplateBinding Foreground}" Margin="2,0,0,0" Placement="Right" Width="4" IsVisible="False" Ticks="{TemplateBinding Ticks}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" TickFrequency="{TemplateBinding TickFrequency}" />
          <Border Name="TrackBackground" BorderThickness="1" Grid.Column="1" HorizontalAlignment="Center" Margin="0,44" Width="4.0" BorderBrush="{DynamicResource SliderThumb.Track.Border}" Background="{DynamicResource SliderThumb.Track.Background}" />
          <Track Name="PART_Track" Grid.Column="1" Orientation="Vertical" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value, Mode=TwoWay}">
            <Track.DecreaseButton>
              <RepeatButton Name="PART_DecreaseButton" Theme="{StaticResource RepeatButtonTransparent}" />
            </Track.DecreaseButton>
            <Track.IncreaseButton>
              <RepeatButton Name="PART_IncreaseButton" Theme="{StaticResource RepeatButtonTransparent}" />
            </Track.IncreaseButton>
            <Thumb Name="Thumb" Focusable="False" VerticalAlignment="Top" BorderBrush="{TemplateBinding BorderBrush}" Theme="{StaticResource SliderThumbVerticalDefault}" />
          </Track>
        </Grid>
      </Border>
    </ControlTemplate>
  </Setter>
  <Style Selector="^[TickPlacement=TopLeft] /template/ TickBar#TopTick">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="^[TickPlacement=TopLeft] /template/ Border#TrackBackground">
    <Setter Property="Margin" Value="2,44,0,44" />
  </Style>
  <Style Selector="^[TickPlacement=BottomRight] /template/ TickBar#BottomTick">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="^[TickPlacement=BottomRight] /template/ Border#TrackBackground">
    <Setter Property="Margin" Value="0,5,2,5" />
  </Style>
</ControlTheme>
