<ControlTheme x:Key="ScrollBarStyle1_cpuset" TargetType="ScrollBar">
  <Setter Property="Background" Value="{DynamicResource ScrollBar.Static.Background}" />
  <Setter Property="BorderBrush" Value="{DynamicResource ScrollBar.Static.Border}" />
  <Setter Property="BorderThickness" Value="1,0" />
  <Setter Property="MinWidth" Value="17" />
  <Setter Property="Template">
    <ControlTemplate>
      <Grid Name="Bg" RowDefinitions="17,*,17">
        <Border Grid.Row="1" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" />
        <RepeatButton Name="PART_LineUpButton" Grid.Row="0" Background="{x:Null}" BorderBrush="{x:Null}" Focusable="False">
          <Path Data="M0,4 C0,4 0,6 0,6 C0,6 3.5,2.5 3.5,2.5 C3.5,2.5 7,6 7,6 C7,6 7,4 7,4 C7,4 3.5,0.5 3.5,0.5 C3.5,0.5 0,4 0,4" Margin="3,4,3,3" Stretch="Uniform" Fill="{DynamicResource ScrollBar.Static.Glyph}" />
        </RepeatButton>
        <RepeatButton Name="PART_LineDownButton" Grid.Row="2" Background="{x:Null}" BorderBrush="{x:Null}" Focusable="False">
          <Path Data="M0,2.5 C0,2.5 0,0.5 0,0.5 C0,0.5 3.5,4 3.5,4 C3.5,4 7,0.5 7,0.5 C7,0.5 7,2.5 7,2.5 C7,2.5 3.5,6 3.5,6 C3.5,6 0,2.5 0,2.5" Margin="3,4,3,3" Stretch="Uniform" Fill="{DynamicResource ScrollBar.Static.Glyph}" />
        </RepeatButton>
        <Track Name="PART_Track" Grid.Row="1" IsDirectionReversed="True" Orientation="Vertical" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}" Value="{TemplateBinding Value, Mode=TwoWay}">
          <Track.DecreaseButton>
            <RepeatButton Name="PART_PageUpButton" Theme="{StaticResource RepeatButtonTransparent}" />
          </Track.DecreaseButton>
          <Track.IncreaseButton>
            <RepeatButton Name="PART_PageDownButton" Theme="{StaticResource RepeatButtonTransparent}" />
          </Track.IncreaseButton>
          <Thumb Theme="{StaticResource ScrollBarThumbVertical}" />
        </Track>
      </Grid>
    </ControlTemplate>
  </Setter>
</ControlTheme>
