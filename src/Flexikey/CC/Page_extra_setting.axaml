    <ControlTheme x:Key="ButtonStyle1_QR" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Button.Static.Background}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Button.Static.Border}"/>
      <Setter Property="Foreground" Value="#FF000000"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="1"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="border" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
            <Grid HorizontalAlignment="Stretch" Margin="0" Width="NaN" Background="#02000000">
              <ContentPresenter x:Name="contentPresenter" Focusable="False" HorizontalAlignment="Left" Margin="30.455,0,0,0" VerticalAlignment="Center" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
              <Image x:Name="Image_Page_ExtraSetting_btn_qr_code_png" HorizontalAlignment="Left" Margin="159,22,0,0" Source="/image/page_extrasetting/btn_qr_code.png" Stretch="Fill" Width="69" VerticalAlignment="Top" Height="69"/>
              <Rectangle x:Name="rectangle" Fill="{TemplateBinding BorderBrush}" HorizontalAlignment="Right" Height="32" Margin="0,10,11.5,0" Stroke="#FF000000" VerticalAlignment="Top" Width="33">
                <Rectangle.OpacityMask>
                  <ImageBrush Source="/image/page_extrasetting/btn_qr_code_open_1.png"/>
                </Rectangle.OpacityMask>
              </Rectangle>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^ /template/ Border#border">
        <Setter Property="BorderBrush" Value="{TemplateBinding BorderBrush}"/>
      </Style>
      <Style Selector="^ /template/ Rectangle#rectangle">
        <Setter Property="IsVisible" Value="False"/>
      </Style>
      <Style Selector="^:pointerover /template/ Rectangle#rectangle">
        <Setter Property="IsVisible" Value="True"/>
      </Style>
      <Style Selector="^:pressed /template/ Rectangle#rectangle">
        <Setter Property="IsVisible" Value="True"/>
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="S_BTN_CLOSE" TargetType="Button">
      <Setter Property="Template">
        <ControlTemplate>
          <Grid x:Name="grid" Margin="0" Width="NaN" Height="NaN" Background="{x:Null}">
            <Image x:Name="Image_ic_close_png" Margin="0" Source="/image/main/ic_close.png" Stretch="Fill" Width="NaN" Height="60"/>
            <Rectangle x:Name="rectangle" Margin="0" Width="NaN" Height="60" Fill="{TemplateBinding Background}" StrokeThickness="0" Stroke="{x:Null}"/>
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^ /template/ Rectangle#rectangle">
        <Setter Property="OpacityMask">
          <LinearGradientBrush EndPoint="50%,100%" StartPoint="50%,0%">
            <GradientStop Color="#00000000"/>
            <GradientStop Color="#33FFFFFF" Offset="1"/>
          </LinearGradientBrush>
        </Setter>
      </Style>
      <Style Selector="^:pressed /template/ Rectangle#rectangle">
        <Setter Property="OpacityMask">
          <LinearGradientBrush EndPoint="50%,100%" StartPoint="50%,0%">
            <GradientStop Color="#00000000" Offset="1"/>
            <GradientStop Color="#66FFFFFF" Offset="0"/>
          </LinearGradientBrush>
        </Setter>
      </Style>
      <Style Selector="^:pointerover /template/ Rectangle#rectangle">
        <Setter Property="OpacityMask">
          <LinearGradientBrush EndPoint="50%,100%" StartPoint="50%,0%">
            <GradientStop Color="#00000000"/>
            <GradientStop Color="#66FFFFFF" Offset="1"/>
          </LinearGradientBrush>
        </Setter>
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="RadioButtonStyle1_FAN" TargetType="RadioButton">
      <Setter Property="Background" Value="{StaticResource RadioButton.Static.Background}"/>
      <Setter Property="BorderBrush" Value="{StaticResource RadioButton.Static.Border}"/>
      <Setter Property="Foreground" Value="#FF000000"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Grid x:Name="templateRoot" Background="#00FFFFFF">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Height="46" Margin="0" VerticalAlignment="Center" Width="46">
              <Rectangle x:Name="rectangle" Margin="0" Width="46" Height="46" StrokeThickness="0" Fill="{TemplateBinding Background}" Stroke="{x:Null}"/>
            </Grid>
            <Border x:Name="radioButtonBorder" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="100" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="1,1,2,1" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" IsVisible="False"/>
            <TextBlock x:Name="textBlock" Grid.Column="1" Margin="0" TextWrapping="Wrap" Text="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^ /template/ TextBlock#textBlock">
        <Setter Property="FontSize" Value="21.333"/>
        <Setter Property="Foreground" Value="#FFB4B4B4"/>
      </Style>
      <Style Selector="^ /template/ Rectangle#rectangle">
        <Setter Property="OpacityMask">
          <ImageBrush Source="/image/page_systemmonitor/fan/btn_enable.png"/>
        </Setter>
      </Style>
      <Style Selector="^:pointerover /template/ TextBlock#textBlock">
        <Setter Property="FontSize" Value="24"/>
      </Style>
      <Style Selector="^:checked /template/ Rectangle#rectangle">
        <Setter Property="OpacityMask">
          <ImageBrush Source="/image/page_systemmonitor/fan/btn_disable.png"/>
        </Setter>
      </Style>
      <Style Selector="^:checked /template/ TextBlock#textBlock">
        <Setter Property="Foreground" Value="#FFFFFFFF"/>
        <Setter Property="FontSize" Value="24"/>
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="RadioButtonStyle1_ONOFF" TargetType="RadioButton">
      <Setter Property="Background" Value="{StaticResource RadioButton.Static.Background}"/>
      <Setter Property="BorderBrush" Value="{StaticResource RadioButton.Static.Border}"/>
      <Setter Property="Foreground" Value="#FF000000"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Grid x:Name="templateRoot" Background="#00FFFFFF">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Height="46" Margin="0" VerticalAlignment="Center" Width="46">
              <Rectangle x:Name="rectangle" Margin="0" Width="46" Height="46" StrokeThickness="0" Fill="{TemplateBinding Background}" Stroke="{x:Null}"/>
            </Grid>
            <Border x:Name="radioButtonBorder" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="100" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="1,1,2,1" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" IsVisible="False"/>
            <TextBlock x:Name="textBlock" Grid.Column="1" Margin="0" TextWrapping="Wrap" Text="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^ /template/ TextBlock#textBlock">
        <Setter Property="FontSize" Value="21.333"/>
        <Setter Property="Foreground" Value="#FFB4B4B4"/>
      </Style>
      <Style Selector="^ /template/ Rectangle#rectangle">
        <Setter Property="OpacityMask">
          <ImageBrush Source="/image/page_systemmonitor/fan/btn_enable.png"/>
        </Setter>
      </Style>
      <Style Selector="^:pointerover /template/ TextBlock#textBlock">
        <Setter Property="FontSize" Value="24"/>
      </Style>
      <Style Selector="^:checked /template/ Rectangle#rectangle">
        <Setter Property="OpacityMask">
          <ImageBrush Source="/image/page_systemmonitor/fan/btn_disable.png"/>
        </Setter>
      </Style>
      <Style Selector="^:checked /template/ TextBlock#textBlock">
        <Setter Property="Foreground" Value="#FFFFFFFF"/>
        <Setter Property="FontSize" Value="24"/>
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="RadioButtonStyle1_HP" TargetType="RadioButton">
      <Setter Property="Background" Value="{StaticResource RadioButton.Static.Background}"/>
      <Setter Property="BorderBrush" Value="{StaticResource RadioButton.Static.Border}"/>
      <Setter Property="Foreground" Value="#FF000000"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Grid x:Name="templateRoot" Background="#00FFFFFF">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="radioButtonBorder" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="100" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="1,1,2,1" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" IsVisible="False" OpacityMask="{x:Null}">
              <Grid x:Name="markGrid" Margin="2">
                <Ellipse x:Name="optionMark" MinWidth="6" MinHeight="6"/>
              </Grid>
            </Border>
            <Grid x:Name="grid" Height="29" Margin="0" VerticalAlignment="Stretch" Width="335">
              <ContentPresenter x:Name="contentPresenter" Grid.Column="0" Focusable="False" Margin="0" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
              <Rectangle x:Name="rectangle" Margin="0" Width="NaN" Height="NaN" StrokeThickness="0" Fill="{TemplateBinding Background}" Stroke="{x:Null}">
                <Rectangle.OpacityMask>
                  <ImageBrush Source="/image/page_extrasetting/btn_headphone_enable_layer_1.png"/>
                </Rectangle.OpacityMask>
              </Rectangle>
              <TextBlock x:Name="textBlock" Margin="0" TextWrapping="Wrap" Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
            </Grid>
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^ /template/ Border#radioButtonBorder">
        <Setter Property="Background" Value="{TemplateBinding Background}"/>
        <Setter Property="BorderBrush" Value="{TemplateBinding BorderBrush}"/>
      </Style>
      <Style Selector="^ /template/ Ellipse#optionMark">
        <Setter Property="Fill" Value="{StaticResource RadioButton.Static.Glyph}"/>
        <Setter Property="Opacity" Value="0"/>
      </Style>
      <Style Selector="^ /template/ TextBlock#textBlock">
        <Setter Property="FontSize" Value="18.667"/>
        <Setter Property="Foreground" Value="#FF6D6D6D"/>
      </Style>
      <Style Selector="^:pointerover /template/ Border#radioButtonBorder">
        <Setter Property="Background" Value="{StaticResource RadioButton.MouseOver.Background}"/>
        <Setter Property="BorderBrush" Value="{StaticResource RadioButton.MouseOver.Border}"/>
      </Style>
      <Style Selector="^:pointerover /template/ Ellipse#optionMark">
        <Setter Property="Fill" Value="{StaticResource RadioButton.MouseOver.Glyph}"/>
      </Style>
      <Style Selector="^:pointerover /template/ TextBlock#textBlock">
        <Setter Property="Foreground" Value="#FFFFFFFF"/>
      </Style>
      <Style Selector="^:disabled /template/ Border#radioButtonBorder">
        <Setter Property="Background" Value="{StaticResource RadioButton.Disabled.Background}"/>
        <Setter Property="BorderBrush" Value="{StaticResource RadioButton.Disabled.Border}"/>
      </Style>
      <Style Selector="^:disabled /template/ Ellipse#optionMark">
        <Setter Property="Fill" Value="{StaticResource RadioButton.Disabled.Glyph}"/>
      </Style>
      <Style Selector="^:pressed /template/ Border#radioButtonBorder">
        <Setter Property="Background" Value="{StaticResource RadioButton.Pressed.Background}"/>
        <Setter Property="BorderBrush" Value="{StaticResource RadioButton.Pressed.Border}"/>
      </Style>
      <Style Selector="^:pressed /template/ Ellipse#optionMark">
        <Setter Property="Fill" Value="{StaticResource RadioButton.Pressed.Glyph}"/>
      </Style>
      <Style Selector="^:checked /template/ Ellipse#optionMark">
        <Setter Property="Opacity" Value="1"/>
      </Style>
      <Style Selector="^:checked /template/ Grid#grid">
        <Setter Property="Background" Value="#FF000000"/>
      </Style>
      <Style Selector="^:checked /template/ TextBlock#textBlock">
        <Setter Property="Foreground" Value="#FFFFFFFF"/>
        <Setter Property="FontSize" Value="26.667"/>
      </Style>
      <Style Selector="^:checked">
        <Setter Property="FontSize" Value="24"/>
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="SliderHorizontal2" TargetType="Slider">
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TickBar x:Name="TopTick" Height="4" Margin="0,0,0,2" Grid.Row="0" IsVisible="False"/>
              <TickBar x:Name="BottomTick" Height="4" Margin="0,2,0,0" Grid.Row="2" IsVisible="False"/>
              <Border x:Name="TrackBackground" BorderThickness="0" Background="#FF5B5B5B" Height="4.0" Margin="5,0" Grid.Row="1" VerticalAlignment="Center">
                <Canvas Margin="-6,-1">
                  <Rectangle x:Name="PART_SelectionRange" Fill="#FF0078D7" Height="4.0" IsVisible="False"/>
                </Canvas>
              </Border>
              <Track x:Name="PART_Track" Grid.Row="1" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value, Mode=TwoWay}" Orientation="{TemplateBinding Orientation}">
                <Track.DecreaseButton>
                  <RepeatButton Theme="{StaticResource RepeatButtonTransparent}" x:Name="PART_DecreaseButton"/>
                </Track.DecreaseButton>
                <Track.IncreaseButton>
                  <RepeatButton Theme="{StaticResource RepeatButtonTransparent}" x:Name="PART_IncreaseButton"/>
                </Track.IncreaseButton>
                <Track.Thumb>
                  <Thumb x:Name="Thumb" Focusable="False" Height="37" Theme="{StaticResource SliderThumbHorizontalDefault_onoff}" VerticalAlignment="Center" Width="66" ClipToBounds="False" BorderBrush="{TemplateBinding BorderBrush}"/>
                </Track.Thumb>
              </Track>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="RBTN_CPU" TargetType="RadioButton">
      <Setter Property="Background" Value="{StaticResource RadioButton.Static.Background}"/>
      <Setter Property="BorderBrush" Value="{StaticResource RadioButton.Static.Border}"/>
      <Setter Property="Foreground" Value="#FF000000"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Grid x:Name="templateRoot" Background="#00FFFFFF">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="textBlock" Grid.ColumnSpan="1" Margin="0" TextWrapping="Wrap" Text="{TemplateBinding Content}" VerticalAlignment="Top" Height="NaN" TextAlignment="Center"/>
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^ /template/ TextBlock#textBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="#FF828282"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Width" Value="100"/>
      </Style>
      <Style Selector="^:pointerover /template/ TextBlock#textBlock">
        <Setter Property="FontSize" Value="18.667"/>
      </Style>
      <Style Selector="^:checked /template/ TextBlock#textBlock">
        <Setter Property="Foreground" Value="#FFFFFFFF"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Width" Value="100"/>
        <Setter Property="FontSize" Value="18.667"/>
      </Style>
    </ControlTheme>
    <SolidColorBrush x:Key="SliderThumb.Static.Foreground" Color="#FFE5E5E5"/>
    <SolidColorBrush x:Key="SliderThumb.MouseOver.Background" Color="#FFDCECFC"/>
    <SolidColorBrush x:Key="SliderThumb.MouseOver.Border" Color="#FF7Eb4EA"/>
    <SolidColorBrush x:Key="SliderThumb.Pressed.Background" Color="#FFDAECFC"/>
    <SolidColorBrush x:Key="SliderThumb.Pressed.Border" Color="#FF569DE5"/>
    <SolidColorBrush x:Key="SliderThumb.Disabled.Background" Color="#FFF0F0F0"/>
    <SolidColorBrush x:Key="SliderThumb.Disabled.Border" Color="#FFD9D9D9"/>
    <SolidColorBrush x:Key="SliderThumb.Static.Background" Color="#FFF0F0F0"/>
    <SolidColorBrush x:Key="SliderThumb.Static.Border" Color="#FFACACAC"/>
    <SolidColorBrush x:Key="SliderThumb.Track.Border" Color="#FFD6D6D6"/>
    <SolidColorBrush x:Key="SliderThumb.Track.Background" Color="#FFE7EAEA"/>
    <ControlTheme x:Key="RepeatButtonTransparent" TargetType="RepeatButton">
      <Setter Property="Background" Value="#00FFFFFF"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Rectangle Fill="{TemplateBinding Background}" Height="{TemplateBinding Height}" Width="{TemplateBinding Width}"/>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
    <ControlTheme x:Key="SliderThumbHorizontalDefault_onoff" TargetType="Thumb">
      <Setter Property="Template">
        <ControlTemplate>
          <Grid HorizontalAlignment="Center" UseLayoutRounding="True" VerticalAlignment="Center">
            <Path x:Name="grip" Data="M0,0 C0,0 11,0 11,0 C11,0 11,18 11,18 C11,18 0,18 0,18 C0,18 0,0 0,0" Stretch="Fill" StrokeThickness="1" UseLayoutRounding="True" VerticalAlignment="Center" IsVisible="False"/>
            <Image x:Name="image_1" HorizontalAlignment="Center" Height="15" Margin="0" VerticalAlignment="Center" Width="44" Source="/image/page_extrasetting/switch_handle_layer_2.png" Stretch="Uniform"/>
            <Rectangle Fill="{TemplateBinding BorderBrush}" HorizontalAlignment="Center" Height="37" Margin="0" VerticalAlignment="Center" Width="66">
              <Rectangle.OpacityMask>
                <ImageBrush Source="/image/page_extrasetting/switch_handle_layer_1.png"/>
              </Rectangle.OpacityMask>
            </Rectangle>
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^ /template/ Path#grip">
        <Setter Property="Fill" Value="{StaticResource SliderThumb.Static.Background}"/>
        <Setter Property="Stroke" Value="{StaticResource SliderThumb.Static.Border}"/>
      </Style>
      <Style Selector="^:pointerover /template/ Path#grip">
        <Setter Property="Fill" Value="{StaticResource SliderThumb.MouseOver.Background}"/>
        <Setter Property="Stroke" Value="{StaticResource SliderThumb.MouseOver.Border}"/>
      </Style>
      <Style Selector="^:pressed /template/ Path#grip">
        <Setter Property="Fill" Value="{StaticResource SliderThumb.Pressed.Background}"/>
        <Setter Property="Stroke" Value="{StaticResource SliderThumb.Pressed.Border}"/>
      </Style>
      <Style Selector="^:disabled /template/ Path#grip">
        <Setter Property="Fill" Value="{StaticResource SliderThumb.Disabled.Background}"/>
        <Setter Property="Stroke" Value="{StaticResource SliderThumb.Disabled.Border}"/>
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="SliderThumbVerticalLeft" TargetType="Thumb">
      <Setter Property="Template">
        <ControlTemplate>
          <Grid HorizontalAlignment="Center" UseLayoutRounding="True" VerticalAlignment="Center">
            <Path x:Name="grip" Data="M6,11 C6,11 0,5.5 0,5.5 C0,5.5 6,0 6,0 C6,0 18,0 18,0 C18,0 18,11 18,11 C18,11 6,11 6,11" Stretch="Fill"/>
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^ /template/ Path#grip">
        <Setter Property="Fill" Value="{StaticResource SliderThumb.Static.Background}"/>
        <Setter Property="Stroke" Value="{StaticResource SliderThumb.Static.Border}"/>
      </Style>
      <Style Selector="^:pointerover /template/ Path#grip">
        <Setter Property="Fill" Value="{StaticResource SliderThumb.MouseOver.Background}"/>
        <Setter Property="Stroke" Value="{StaticResource SliderThumb.MouseOver.Border}"/>
      </Style>
      <Style Selector="^:pressed /template/ Path#grip">
        <Setter Property="Fill" Value="{StaticResource SliderThumb.Pressed.Background}"/>
        <Setter Property="Stroke" Value="{StaticResource SliderThumb.Pressed.Border}"/>
      </Style>
      <Style Selector="^:disabled /template/ Path#grip">
        <Setter Property="Fill" Value="{StaticResource SliderThumb.Disabled.Background}"/>
        <Setter Property="Stroke" Value="{StaticResource SliderThumb.Disabled.Border}"/>
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="SliderThumbVerticalRight" TargetType="Thumb">
      <Setter Property="Template">
        <ControlTemplate>
          <Grid HorizontalAlignment="Center" UseLayoutRounding="True" VerticalAlignment="Center">
            <Path x:Name="grip" Data="M12,11 C12,11 18,5.5 18,5.5 C18,5.5 12,0 12,0 C12,0 0,0 0,0 C0,0 0,11 0,11 C0,11 12,11 12,11" Stretch="Fill"/>
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^ /template/ Path#grip">
        <Setter Property="Fill" Value="{StaticResource SliderThumb.Static.Background}"/>
        <Setter Property="Stroke" Value="{StaticResource SliderThumb.Static.Border}"/>
      </Style>
      <Style Selector="^:pointerover /template/ Path#grip">
        <Setter Property="Fill" Value="{StaticResource SliderThumb.MouseOver.Background}"/>
        <Setter Property="Stroke" Value="{StaticResource SliderThumb.MouseOver.Border}"/>
      </Style>
      <Style Selector="^:pressed /template/ Path#grip">
        <Setter Property="Fill" Value="{StaticResource SliderThumb.Pressed.Background}"/>
        <Setter Property="Stroke" Value="{StaticResource SliderThumb.Pressed.Border}"/>
      </Style>
      <Style Selector="^:disabled /template/ Path#grip">
        <Setter Property="Fill" Value="{StaticResource SliderThumb.Disabled.Background}"/>
        <Setter Property="Stroke" Value="{StaticResource SliderThumb.Disabled.Border}"/>
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="SliderThumbVerticalDefault" TargetType="Thumb">
      <Setter Property="Template">
        <ControlTemplate>
          <Grid HorizontalAlignment="Center" UseLayoutRounding="True" VerticalAlignment="Center">
            <Path x:Name="grip" Data="M0.5,0.5 L18.5,0.5 L18.5,11.5 L0.5,11.5" Stretch="Fill"/>
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^ /template/ Path#grip">
        <Setter Property="Fill" Value="{StaticResource SliderThumb.Static.Background}"/>
        <Setter Property="Stroke" Value="{StaticResource SliderThumb.Static.Border}"/>
      </Style>
      <Style Selector="^:pointerover /template/ Path#grip">
        <Setter Property="Fill" Value="{StaticResource SliderThumb.MouseOver.Background}"/>
        <Setter Property="Stroke" Value="{StaticResource SliderThumb.MouseOver.Border}"/>
      </Style>
      <Style Selector="^:pressed /template/ Path#grip">
        <Setter Property="Fill" Value="{StaticResource SliderThumb.Pressed.Background}"/>
        <Setter Property="Stroke" Value="{StaticResource SliderThumb.Pressed.Border}"/>
      </Style>
      <Style Selector="^:disabled /template/ Path#grip">
        <Setter Property="Fill" Value="{StaticResource SliderThumb.Disabled.Background}"/>
        <Setter Property="Stroke" Value="{StaticResource SliderThumb.Disabled.Border}"/>
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="SliderVertical" TargetType="Slider">
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition MinWidth="{TemplateBinding MinWidth}" Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TickBar x:Name="TopTick" Grid.Column="0" Fill="{TemplateBinding Foreground}" Margin="0,0,2,0" Width="4"/>
              <TickBar x:Name="BottomTick" Grid.Column="2" Fill="{TemplateBinding Foreground}" Margin="2,0,0,0" Width="4"/>
              <Border x:Name="TrackBackground" BorderThickness="1" Grid.Column="1" HorizontalAlignment="Center" Width="4.0" BorderBrush="{StaticResource SliderThumb.Track.Border}" Background="{StaticResource SliderThumb.Track.Background}">
                <Canvas Margin="-1,-6">
                  <Rectangle x:Name="PART_SelectionRange" Fill="#FF0078D7" Width="4.0"/>
                </Canvas>
              </Border>
              <Track x:Name="PART_Track" Grid.Column="1" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value, Mode=TwoWay}" Orientation="{TemplateBinding Orientation}">
                <Track.DecreaseButton>
                  <RepeatButton Theme="{StaticResource RepeatButtonTransparent}" x:Name="PART_DecreaseButton"/>
                </Track.DecreaseButton>
                <Track.IncreaseButton>
                  <RepeatButton Theme="{StaticResource RepeatButtonTransparent}" x:Name="PART_IncreaseButton"/>
                </Track.IncreaseButton>
                <Track.Thumb>
                  <Thumb x:Name="Thumb" Focusable="False" Height="11" VerticalAlignment="Top" Width="18" Theme="{StaticResource SliderThumbVerticalDefault}"/>
                </Track.Thumb>
              </Track>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^ /template/ TickBar#TopTick">
        <Setter Property="IsVisible" Value="False"/>
      </Style>
      <Style Selector="^ /template/ Border#TrackBackground">
        <Setter Property="Margin" Value="0,5"/>
      </Style>
      <Style Selector="^ /template/ TickBar#BottomTick">
        <Setter Property="IsVisible" Value="False"/>
      </Style>
      <Style Selector="^ /template/ Rectangle#PART_SelectionRange">
        <Setter Property="IsVisible" Value="False"/>
      </Style>
      <Style Selector="^:focus /template/ Thumb#Thumb">
        <Setter Property="Foreground" Value="#FF0000FF"/>
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="SliderStyle1_ONOFF" TargetType="Slider">
      <Setter Property="Background" Value="#00FFFFFF"/>
      <Setter Property="BorderBrush" Value="#00FFFFFF"/>
      <Setter Property="Foreground" Value="{StaticResource SliderThumb.Static.Foreground}"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TickBar x:Name="TopTick" Height="4" Margin="0,0,0,2" Grid.Row="0" IsVisible="False"/>
              <TickBar x:Name="BottomTick" Height="4" Margin="0,2,0,0" Grid.Row="2" IsVisible="False"/>
              <Border x:Name="TrackBackground" BorderThickness="0" Background="#FF5B5B5B" Height="4.0" Margin="5,0" Grid.Row="1" VerticalAlignment="Center">
                <Canvas Margin="-6,-1">
                  <Rectangle x:Name="PART_SelectionRange" Fill="#FF0078D7" Height="4.0" IsVisible="False"/>
                </Canvas>
              </Border>
              <Track x:Name="PART_Track" Grid.Row="1" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value, Mode=TwoWay}" Orientation="{TemplateBinding Orientation}">
                <Track.DecreaseButton>
                  <RepeatButton Theme="{StaticResource RepeatButtonTransparent}" x:Name="PART_DecreaseButton"/>
                </Track.DecreaseButton>
                <Track.IncreaseButton>
                  <RepeatButton Theme="{StaticResource RepeatButtonTransparent}" x:Name="PART_IncreaseButton"/>
                </Track.IncreaseButton>
                <Track.Thumb>
                  <Thumb x:Name="Thumb" Focusable="False" Height="37" Theme="{StaticResource SliderThumbHorizontalDefault_onoff}" VerticalAlignment="Center" Width="66" ClipToBounds="False" BorderBrush="{TemplateBinding BorderBrush}"/>
                </Track.Thumb>
              </Track>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^[Orientation=Vertical]">
      </Style>
    </ControlTheme>
  </UserControl.Resources>
  <Grid x:Name="main" Width="1920" Height="1080">
