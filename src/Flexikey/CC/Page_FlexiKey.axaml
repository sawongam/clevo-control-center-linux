  <UserControl.Resources>
    <SolidColorBrush x:Key="RadioButton.Static.Background" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="RadioButton.Static.Border" Color="#FF707070"/>
    <ControlTheme x:Key="RBTN_CPU" TargetType="RadioButton">
      <Setter Property="Background" Value="{StaticResource RadioButton.Static.Background}"/>
      <Setter Property="BorderBrush" Value="{StaticResource RadioButton.Static.Border}"/>
      <Setter Property="Foreground" Value="#FF000000"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Grid x:Name="templateRoot" Background="#00FFFFFF">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="textBlock" Grid.ColumnSpan="1" HorizontalAlignment="Center" Margin="0" TextWrapping="Wrap" Width="NaN" Text="{TemplateBinding Content}" VerticalAlignment="Center" Height="NaN" TextAlignment="Center"/>
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^ /template/ TextBlock#textBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="Foreground" Value="#FF8D8D8D"/>
      </Style>
      <Style Selector="^:pointerover /template/ TextBlock#textBlock">
        <Setter Property="FontSize" Value="24"/>
      </Style>
      <Style Selector="^:checked /template/ TextBlock#textBlock">
        <Setter Property="Foreground" Value="#FFFFFFFF"/>
        <Setter Property="FontSize" Value="24"/>
      </Style>
    </ControlTheme>
    <SolidColorBrush x:Key="Button.Static.Background" Color="#FFDDDDDD"/>
    <SolidColorBrush x:Key="Button.Static.Border" Color="#FF707070"/>
    <ControlTheme x:Key="ButtonStyle1_SAVE" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Button.Static.Background}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Button.Static.Border}"/>
      <Setter Property="Foreground" Value="#FF000000"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="1"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="border">
            <WrapPanel Margin="0">
              <Image x:Name="Image_Page_SystemMonitor_btn_save_normal_png" Margin="0" Stretch="Fill" Width="56" Height="56" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="Hand"/>
              <TextBlock x:Name="textBlock" Height="NaN" TextWrapping="Wrap" Text="{TemplateBinding Content}" Width="NaN" VerticalAlignment="Center"/>
            </WrapPanel>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^ /template/ Image#Image_Page_SystemMonitor_btn_save_normal_png">
        <Setter Property="Source" Value="/image/page_systemmonitor/btn_save_normal.png"/>
      </Style>
      <Style Selector="^:pointerover /template/ Image#Image_Page_SystemMonitor_btn_save_normal_png">
        <Setter Property="Source" Value="/image/page_systemmonitor/btn_save_hover.png"/>
      </Style>
      <Style Selector="^:pressed /template/ Image#Image_Page_SystemMonitor_btn_save_normal_png">
        <Setter Property="Source" Value="/image/page_systemmonitor/btn_save_pressed.png"/>
      </Style>
      <Style Selector="^:pressed /template/ TextBlock#textBlock">
        <Setter Property="Foreground" Value="#FF808080"/>
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Opacity" Value="0.2"/>
      </Style>
      <Style Selector="^:not(:disabled) /template/ Border#border">
        <Style.Animations>
          <Animation Duration="00:00:01.000" IterationCount="Infinite">
            <KeyFrame Cue="0%">
              <Setter Property="Opacity" Value="1"/>
            </KeyFrame>
            <KeyFrame Cue="50%">
              <Setter Property="Opacity" Value="0.2"/>
            </KeyFrame>
            <KeyFrame Cue="100%">
              <Setter Property="Opacity" Value="1"/>
            </KeyFrame>
          </Animation>
        </Style.Animations>
      </Style>
    </ControlTheme>
