            <TextBlock x:Name="textBlock" Grid.ColumnSpan="2" Margin="65,0,0,0" TextWrapping="Wrap" Text="{TemplateBinding Content}" HorizontalAlignment="Left" VerticalAlignment="Center" Height="25"/>
            <Image x:Name="Image_Page_FlexiKey_macro_ic_start_key_png" Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="0" Stretch="Fill" Width="70" Height="70" VerticalAlignment="Top"/>
