    <RadioButton x:Name="RBTN_MouseStatus_disable" Content="Disable" Foreground="#FFFFFFFF" FontFamily="Microsoft Sans Serif" FontSize="18.667" VerticalContentAlignment="Center" Theme="{StaticResource RBTN_CPU2}" GroupName="MouseStatus" Cursor="Hand" Margin="0,1016,198.4,0" VerticalAlignment="Top" Width="100" HorizontalAlignment="Right" IsChecked="True" IsVisible="{Binding IsVisible, ElementName=SL_FlexiKey_Mouse_status}" IsCheckedChanged="RBTN_MouseStatus_disable_Checked"/>
