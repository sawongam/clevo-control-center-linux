              <Rectangle x:Name="R1" Fill="{TemplateBinding Background}" Margin="0" HorizontalAlignment="Left" Width="12" Height="30"/>
              <Rectangle x:Name="R2" Fill="{TemplateBinding Background}" Margin="0" Height="30" HorizontalAlignment="Left" VerticalAlignment="Top" Width="{Binding ActualWidth, ElementName=contentPresenter}"/>
