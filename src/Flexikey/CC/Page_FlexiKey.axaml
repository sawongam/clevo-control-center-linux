          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^ /template/ StackPanel#stackPanel">
        <Setter Property="IsVisible" Value="False"/>
      </Style>
      <Style Selector="^:disabled /template/ TextBlock#textBlock">
