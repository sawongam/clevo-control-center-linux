    <ControlTheme x:Key="SliderVertical" TargetType="Slider">
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition MinWidth="{TemplateBinding MinWidth}" Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TickBar x:Name="TopTick" Grid.Column="0" Fill="{TemplateBinding Foreground}" Margin="0,0,2,0" Width="4"/>
              <TickBar x:Name="BottomTick" Grid.Column="2" Fill="{TemplateBinding Foreground}" Margin="2,0,0,0" Width="4"/>
              <Border x:Name="TrackBackground" BorderThickness="1" Grid.Column="1" HorizontalAlignment="Center" Width="4.0" BorderBrush="{StaticResource SliderThumb.Track.Border}" Background="{StaticResource SliderThumb.Track.Background}">
                <Canvas Margin="-1,-6">
                  <Rectangle x:Name="PART_SelectionRange" Fill="#FF0078D7" Width="4.0"/>
                </Canvas>
              </Border>
              <Track x:Name="PART_Track" Grid.Column="1" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value, Mode=TwoWay}" Orientation="{TemplateBinding Orientation}">
                <Track.DecreaseButton>
                  <RepeatButton Theme="{StaticResource RepeatButtonTransparent}" x:Name="PART_DecreaseButton"/>
                </Track.DecreaseButton>
                <Track.IncreaseButton>
                  <RepeatButton Theme="{StaticResource RepeatButtonTransparent}" x:Name="PART_IncreaseButton"/>
                </Track.IncreaseButton>
                <Track.Thumb>
                  <Thumb x:Name="Thumb" Focusable="False" Height="11" VerticalAlignment="Top" Width="18" Theme="{StaticResource SliderThumbVerticalDefault}"/>
                </Track.Thumb>
              </Track>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^ /template/ TickBar#TopTick">
        <Setter Property="IsVisible" Value="False"/>
      </Style>
      <Style Selector="^ /template/ Border#TrackBackground">
        <Setter Property="Margin" Value="0,5"/>
      </Style>
      <Style Selector="^ /template/ TickBar#BottomTick">
        <Setter Property="IsVisible" Value="False"/>
      </Style>
      <Style Selector="^ /template/ Rectangle#PART_SelectionRange">
        <Setter Property="IsVisible" Value="False"/>
      </Style>
      <Style Selector="^:focus /template/ Thumb#Thumb">
        <Setter Property="Foreground" Value="#FF0000FF"/>
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="SliderStyle1_ONOFF" TargetType="Slider">
      <Setter Property="Background" Value="#00FFFFFF"/>
      <Setter Property="BorderBrush" Value="#00FFFFFF"/>
      <Setter Property="Foreground" Value="{StaticResource SliderThumb.Static.Foreground}"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TickBar x:Name="TopTick" Height="4" Margin="0,0,0,2" Grid.Row="0" IsVisible="False"/>
              <TickBar x:Name="BottomTick" Height="4" Margin="0,2,0,0" Grid.Row="2" IsVisible="False"/>
              <Border x:Name="TrackBackground" BorderThickness="0" Background="#FF5B5B5B" Height="4.0" Margin="5,0" Grid.Row="1" VerticalAlignment="Center">
                <Canvas Margin="-6,-1">
                  <Rectangle x:Name="PART_SelectionRange" Fill="#FF0078D7" Height="4.0" IsVisible="False"/>
                </Canvas>
              </Border>
              <Track x:Name="PART_Track" Grid.Row="1" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value, Mode=TwoWay}" Orientation="{TemplateBinding Orientation}">
                <Track.DecreaseButton>
                  <RepeatButton Theme="{StaticResource RepeatButtonTransparent}" x:Name="PART_DecreaseButton"/>
                </Track.DecreaseButton>
                <Track.IncreaseButton>
                  <RepeatButton Theme="{StaticResource RepeatButtonTransparent}" x:Name="PART_IncreaseButton"/>
                </Track.IncreaseButton>
                <Track.Thumb>
                  <Thumb x:Name="Thumb" Focusable="False" Height="37" Theme="{StaticResource SliderThumbHorizontalDefault_onoff}" VerticalAlignment="Center" Width="66" ClipToBounds="False" BorderBrush="{TemplateBinding BorderBrush}"/>
                </Track.Thumb>
              </Track>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^[Orientation=Vertical]">
      </Style>
    </ControlTheme>
