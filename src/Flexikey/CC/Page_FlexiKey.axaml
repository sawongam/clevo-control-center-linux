    <ControlTheme x:Key="CheckBoxStyle_ExpressKey_Start" TargetType="CheckBox">
      <Setter Property="Background" Value="{StaticResource OptionMark.Static.Background}"/>
      <Setter Property="BorderBrush" Value="{StaticResource OptionMark.Static.Border}"/>
      <Setter Property="Foreground" Value="#FF000000"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Grid x:Name="templateRoot" Background="#00FFFFFF">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ContentPresenter x:Name="contentPresenter" Grid.Column="1" Focusable="False" Margin="12,0,0,18" HorizontalAlignment="Left" VerticalAlignment="Bottom" IsVisible="False" Height="25" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
            <TextBlock x:Name="textBlock" Grid.ColumnSpan="2" Margin="65,0,0,0" TextWrapping="Wrap" Text="{TemplateBinding Content}" HorizontalAlignment="Left" VerticalAlignment="Center" Height="25"/>
            <Image x:Name="Image_Page_FlexiKey_macro_ic_start_key_png" Grid.ColumnSpan="2" HorizontalAlignment="Left" Margin="0" Stretch="Fill" Width="56" Height="56" VerticalAlignment="Top"/>
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^ /template/ TextBlock#textBlock">
        <Setter Property="Foreground" Value="#FF8B8B8B"/>
      </Style>
      <Style Selector="^ /template/ Image#Image_Page_FlexiKey_macro_ic_start_key_png">
        <Setter Property="Source" Value="/image/page_flexikey/macro/btn_macro_start_record_normal.png"/>
      </Style>
      <Style Selector="^:pointerover /template/ TextBlock#textBlock">
        <Setter Property="Foreground" Value="#FFFFFFFF"/>
      </Style>
      <Style Selector="^:disabled /template/ TextBlock#textBlock">
        <Setter Property="Foreground" Value="#FF8B8B8B"/>
      </Style>
      <Style Selector="^:checked /template/ Image#Image_Page_FlexiKey_macro_ic_start_key_png">
        <Setter Property="Source" Value="/image/page_flexikey/macro/btn_macro_stop_record_normal.png"/>
      </Style>
      <Style Selector="^:checked /template/ TextBlock#textBlock">
        <Setter Property="Foreground" Value="#FFFF0000"/>
      </Style>
      <Style Selector="^:checked /template/ TextBlock#textBlock">
        <Style.Animations>
          <Animation Duration="00:00:00.500" IterationCount="Infinite">
            <KeyFrame Cue="0%">
              <Setter Property="Foreground" Value="#FFBFBFBF"/>
            </KeyFrame>
            <KeyFrame Cue="100%">
              <Setter Property="Foreground" Value="Red"/>
            </KeyFrame>
          </Animation>
        </Style.Animations>
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="CheckBoxStyle_EnableTime" TargetType="CheckBox">
