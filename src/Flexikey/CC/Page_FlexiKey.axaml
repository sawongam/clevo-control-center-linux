    <ControlTheme x:Key="RBTN_CPU2" TargetType="RadioButton">
      <Setter Property="Background" Value="{StaticResource RadioButton.Static.Background}"/>
      <Setter Property="BorderBrush" Value="{StaticResource RadioButton.Static.Border}"/>
      <Setter Property="Foreground" Value="#FF000000"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Grid x:Name="templateRoot" Background="#00FFFFFF">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="textBlock" Grid.ColumnSpan="1" Margin="0" TextWrapping="Wrap" Text="{TemplateBinding Content}" VerticalAlignment="Top" Height="NaN" TextAlignment="Center"/>
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^ /template/ TextBlock#textBlock">
        <Setter Property="FontSize" Value="18.667"/>
        <Setter Property="Foreground" Value="#FF828282"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Width" Value="100"/>
      </Style>
      <Style Selector="^:pointerover /template/ TextBlock#textBlock">
        <Setter Property="FontSize" Value="18.667"/>
      </Style>
      <Style Selector="^:checked /template/ TextBlock#textBlock">
        <Setter Property="Foreground" Value="#FFFFFFFF"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Width" Value="100"/>
        <Setter Property="FontSize" Value="18.667"/>
      </Style>
    </ControlTheme>
    <SolidColorBrush x:Key="SliderThumb.Static.Foreground" Color="#FFE5E5E5"/>
