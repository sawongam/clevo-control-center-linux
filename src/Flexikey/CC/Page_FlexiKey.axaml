        <Button x:Name="BTN_profile_add" Content="" Theme="{StaticResource ButtonStyle_add}" Cursor="Hand" Foreground="#FFFFFFFF" FontFamily="Microsoft Sans Serif" FontSize="24" Width="56" Height="56" Click="BTN_profile_add_Click"/>
