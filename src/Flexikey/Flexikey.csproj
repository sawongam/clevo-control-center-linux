    <FileVersion>3.92.2.0</FileVersion>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Flexikey</AssemblyName>
    <RootNamespace>CC</RootNamespace>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../RippleCC.Platform/RippleCC.Platform.csproj" />
