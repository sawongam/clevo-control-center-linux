<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:CC" xmlns:UControl="using:CC.UControl"
        x:Class="CC.MainWindow" Name="window" Title="Battery Utility" Height="1080" Width="1920"
        WindowStartupLocation="Manual" Background="#FF000000" Topmost="True" WindowDecorations="None"
        TransparencyLevelHint="Transparent" CanResize="True" FontSize="12" UseLayoutRounding="True">
  <Window.Resources>
    <ControlTheme x:Key="BTN_MIN" TargetType="Button">
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Name="grid" Background="{x:Null}">
            <Image Source="/Image/main/ic_minimize.png" Stretch="Fill" Height="60" />
            <Rectangle Name="rectangle" Height="60" Fill="{TemplateBinding Background}" StrokeThickness="0">
              <Rectangle.OpacityMask>
                <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                  <GradientStop Color="#00000000" Offset="0" />
                  <GradientStop Color="#33FFFFFF" Offset="1" />
                </LinearGradientBrush>
              </Rectangle.OpacityMask>
            </Rectangle>
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ Rectangle#rectangle">
        <Setter Property="OpacityMask">
          <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
            <GradientStop Color="#00000000" Offset="0" />
            <GradientStop Color="#66FFFFFF" Offset="1" />
          </LinearGradientBrush>
        </Setter>
      </Style>
      <Style Selector="^:pressed /template/ Rectangle#rectangle">
        <Setter Property="OpacityMask">
          <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
            <GradientStop Color="#66FFFFFF" Offset="0" />
            <GradientStop Color="#00000000" Offset="1" />
          </LinearGradientBrush>
        </Setter>
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="S_BTN_CLOSE" TargetType="Button">
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Name="grid" Background="{x:Null}">
            <Image Source="/Image/main/ic_close.png" Stretch="Fill" Height="60" />
            <Rectangle Name="rectangle" Height="60" Fill="{TemplateBinding Background}" StrokeThickness="0">
              <Rectangle.OpacityMask>
                <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                  <GradientStop Color="#00000000" Offset="0" />
                  <GradientStop Color="#33FFFFFF" Offset="1" />
                </LinearGradientBrush>
              </Rectangle.OpacityMask>
            </Rectangle>
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ Rectangle#rectangle">
        <Setter Property="OpacityMask">
          <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
            <GradientStop Color="#00000000" Offset="0" />
            <GradientStop Color="#66FFFFFF" Offset="1" />
          </LinearGradientBrush>
        </Setter>
      </Style>
      <Style Selector="^:pressed /template/ Rectangle#rectangle">
        <Setter Property="OpacityMask">
          <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
            <GradientStop Color="#66FFFFFF" Offset="0" />
            <GradientStop Color="#00000000" Offset="1" />
          </LinearGradientBrush>
        </Setter>
      </Style>
    </ControlTheme>
    <ControlTheme x:Key="CheckBox_FullScreen" TargetType="CheckBox">
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Name="templateRoot" Background="#00FFFFFF">
            <Image Name="Image_ic_close_png" Source="/Image/main/ic_fullscreen.png" Stretch="Fill" Width="80" Height="60" />
            <Rectangle Name="rectangle" Width="80" Height="60" Fill="{TemplateBinding Background}" StrokeThickness="0">
              <Rectangle.OpacityMask>
                <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                  <GradientStop Color="#00000000" Offset="0" />
                  <GradientStop Color="#33FFFFFF" Offset="1" />
                </LinearGradientBrush>
              </Rectangle.OpacityMask>
            </Rectangle>
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ Rectangle#rectangle">
        <Setter Property="OpacityMask">
          <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
            <GradientStop Color="#00000000" Offset="0" />
            <GradientStop Color="#66FFFFFF" Offset="1" />
          </LinearGradientBrush>
        </Setter>
      </Style>
      <Style Selector="^:pressed /template/ Rectangle#rectangle">
        <Setter Property="OpacityMask">
          <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
            <GradientStop Color="#66000000" Offset="0" />
            <GradientStop Color="Transparent" Offset="1" />
          </LinearGradientBrush>
        </Setter>
      </Style>
    </ControlTheme>
  </Window.Resources>
  <Border BorderThickness="0,0,1,1" BorderBrush="{Binding Fill, ElementName=title_icon}">
  <Grid Margin="0">
    <Viewbox Name="VB_main" Margin="0">
      <Grid Name="_base" Height="1080" Width="1920" Background="#FF242424">
        <Grid Name="main_windowStyle_forBAT" Height="78" VerticalAlignment="Top" Width="247.649" Background="#FF242424" HorizontalAlignment="Right" Margin="0,5,5,0" IsVisible="False">
          <CheckBox Name="Check_FullSrceen1" Content="" Margin="0" BorderThickness="0" Theme="{StaticResource CheckBox_FullScreen}" IsChecked="True" Width="80" Height="60" Focusable="False" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand" IsVisible="False" Background="{Binding Fill, ElementName=title_icon}" Click="Check_FullSrceen_Click" />
          <Button Name="BTN_min1" Content="" Margin="0" BorderThickness="0" Theme="{StaticResource BTN_MIN}" Width="80" HorizontalAlignment="Left" Height="60" VerticalAlignment="Center" Cursor="Hand" IsVisible="False" Focusable="False" Background="{Binding Fill, ElementName=title_icon}" Click="BTN_min_Click" />
          <Button Name="BTN_close1" Content="" BorderThickness="0" Theme="{StaticResource S_BTN_CLOSE}" Width="80" HorizontalAlignment="Right" Height="60" VerticalAlignment="Center" Cursor="Hand" Focusable="False" Background="{Binding Fill, ElementName=title_icon}" Click="BTN_close_Click" />
        </Grid>
        <local:Page_Battery_Refresh Name="page_battery_refresh" Width="1920" Height="1080" IsVisible="False"
                                    BorderBrush="{Binding Fill, ElementName=title_icon}" />
        <Grid Name="main_title_icon" HorizontalAlignment="Left" Height="81" Margin="0" VerticalAlignment="Top" Width="1920">
          <Rectangle Name="title_icon" Margin="503.667,2.254,506.333,-0.254" StrokeThickness="0" Height="79" Fill="#FFFF00D2">
            <Rectangle.OpacityMask>
              <ImageBrush Source="/Image/main/bg_title_bar_3.png" />
            </Rectangle.OpacityMask>
          </Rectangle>
          <StackPanel HorizontalAlignment="Center" Height="79" Margin="0,2,0,0" VerticalAlignment="Top" Orientation="Horizontal">
            <Image Name="Image_logo" HorizontalAlignment="Center" Source="/Image/main/control center logo.png" Stretch="Fill" Width="60" Height="60" VerticalAlignment="Center" />
            <Image Name="Image_title" HorizontalAlignment="Center" Margin="0" Source="/Image/main/title_layer_3.png" Stretch="Fill" Height="24" VerticalAlignment="Center" />
          </StackPanel>
          <Path Name="title_move" Data="M510.66635,-0.26633186 L1408.2798,0.26699932 L1409.0529,47.920679 C1379.296,61.663167 1347.4821,73.013403 1312.9944,81.254006 L608.3589,81.200006 C570.69768,71.593271 538.53856,60.18705 511.14966,47.137546" Fill="#02FFFFFF" Margin="510.667,-0.267,511.494,-0.254" Stretch="Fill" StrokeThickness="0" Cursor="SizeAll" PointerPressed="title_move_PointerPressed" PointerMoved="title_move_PointerMoved" />
          <Rectangle Name="title_icon_Copy" HorizontalAlignment="Left" Margin="0" StrokeThickness="0" Width="1920" Height="2" VerticalAlignment="Top"
                     Fill="{Binding Fill, ElementName=title_icon}">
            <Rectangle.OpacityMask>
              <LinearGradientBrush StartPoint="99.8%,-1.1%" EndPoint="0.1%,0.2%">
                <GradientStop Color="Black" Offset="0.426" />
                <GradientStop Color="#00000000" Offset="0.992" />
                <GradientStop Color="#00181818" Offset="0.038" />
                <GradientStop Color="#FF202020" Offset="0.579" />
              </LinearGradientBrush>
            </Rectangle.OpacityMask>
          </Rectangle>
        </Grid>
        <UControl:UserControl_DialogBox Name="UC_DialogBox" Height="1080" Width="1920" IsVisible="False" />
      </Grid>
    </Viewbox>
    <Viewbox Name="VB_Style" HorizontalAlignment="Right" Margin="0,5,5,0" VerticalAlignment="Top" Width="500" Height="77">
      <Grid Name="main_windowStyle" Height="78" VerticalAlignment="Top" Width="247.649" Background="#FF242424" HorizontalAlignment="Right">
        <Path Name="title_move_Copy" Data="M510.66635,-0.26633186 L1408.2798,0.26699932 L1408.0422,81.518425 C1408.0422,81.518425 506.33946,80.988292 506.33946,80.988292" Margin="-189.455,0,247.747,-0.254" Stretch="Fill" StrokeThickness="0" Cursor="SizeAll" HorizontalAlignment="Right" Width="189.357" PointerPressed="title_move_PointerPressed" PointerMoved="title_move_PointerMoved">
          <Path.Fill>
            <LinearGradientBrush StartPoint="84.4%,49.8%" EndPoint="-4%,49.5%">
              <GradientStop Color="#FF242424" Offset="0" />
              <GradientStop Color="#00242424" Offset="1" />
            </LinearGradientBrush>
          </Path.Fill>
        </Path>
        <CheckBox Name="Check_FullSrceen" Content="" Margin="0" BorderThickness="0" Theme="{StaticResource CheckBox_FullScreen}" IsChecked="True" Width="80" Height="60" Focusable="False" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand" IsVisible="False" Background="{Binding Fill, ElementName=title_icon}" Click="Check_FullSrceen_Click" />
        <Button Name="BTN_min" Content="" Margin="0" BorderThickness="0" Theme="{StaticResource BTN_MIN}" Width="80" HorizontalAlignment="Left" Height="60" VerticalAlignment="Center" Cursor="Hand" Focusable="False" IsVisible="False" Background="{Binding Fill, ElementName=title_icon}" Click="BTN_min_Click" />
        <Button Name="BTN_close" Content="" BorderThickness="0" Theme="{StaticResource S_BTN_CLOSE}" Width="80" HorizontalAlignment="Right" Height="60" VerticalAlignment="Center" Cursor="Hand" Focusable="False" Background="{Binding Fill, ElementName=title_icon}" Click="BTN_close_Click" />
      </Grid>
    </Viewbox>
  </Grid>
  </Border>
</Window>
