#!/bin/sh
set -e

if [ "$1" = configure ]; then
    # Registers, builds and installs the module for the installed kernels.
    /usr/lib/dkms/common.postinst ccenter_dchu @MODULE_VERSION@ /usr/share/ccenter "" "$2" || true
    modprobe ccenter_dchu 2>/dev/null || true
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload
        systemctl enable ccenterd >/dev/null 2>&1 || true
        systemctl restart ccenterd >/dev/null 2>&1 || true
    fi
fi
