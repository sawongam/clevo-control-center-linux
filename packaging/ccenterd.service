[Unit]
Description=Clevo Control Center hardware daemon
After=systemd-modules-load.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStartPre=-/sbin/modprobe ccenter_dchu
ExecStart=/opt/ccenter/bin/ccenterd
RuntimeDirectory=ccenter
StateDirectory=ccenter
Restart=on-failure
# ccenterd exits 78 when /dev/ccenter_dchu is missing: do not restart-loop on that.
RestartPreventExitStatus=78
RestartSec=2
ProtectHome=yes
ProtectSystem=strict
NoNewPrivileges=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
