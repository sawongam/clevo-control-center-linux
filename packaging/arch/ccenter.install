post_install() {
  echo "The kernel module is built by DKMS and needs the headers for your kernel (for example linux-headers)."
  echo "Start the hardware service with:  systemctl enable --now ccenterd"
}

post_upgrade() {
  systemctl try-restart ccenterd 2>/dev/null || true
}

pre_remove() {
  systemctl disable --now ccenterd 2>/dev/null || true
  rmmod ccenter_dchu 2>/dev/null || true
}
